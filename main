[67], weight = 0.48, speedBias = 1.00, moveBias = 0.65}, {name = __S[70], weight = 0.48, speedBias = 1.00, moveBias = 0.65}, {name = __S[62], weight = 0.45, speedBias = 1.00, moveBias = 0.40}, {name = __S[65], weight = 0.45, speedBias = 1.00, moveBias = 0.40}, {name = __S[68], weight = 0.40, speedBias = 1.00, moveBias = 0.65}, {name = __S[71], weight = 0.40, speedBias = 1.00, moveBias = 0.65}, {name = __S[39], weight = 0.65, speedBias = 0.90, moveBias = 0.38}, {name = __S[41], weight = 0.65, speedBias = 0.90, moveBias = 0.38}, {name = __S[43], weight = 0.60, speedBias = 0.90, moveBias = 0.58}, {name = __S[45], weight = 0.60, speedBias = 0.90, moveBias = 0.58}, } local AIM_TARGET_RNG = Random.new() local AIM_TUNE = { predictionScale = 0.45, lateralLead = 0.0018, mouseLead = 0.15, maxLeadStuds = 7, maxResist = 0.75, breakAngle = 2.2, releaseTime = 0.45, push = 0, releaseUntil = 0, releaseStart = 0, lastLook = nil, lastLookChar = nil, } AIM_TUNE.style = __S[492] AIM_TUNE.sm = { minRate = 5, maxRate = 24, minDeg = 120, maxDeg = 900, reactDelay = 0.04, easeIn = 0.14, leadTime = 0.07, maxLead = 6, yieldRef = 0.012, blatRate = 28, blatDeg = 1500, jumpVel = 20, flickTime = 0.22, flickRate = 40, flickDeg = 2500, flickUntil = 0, wasJump = false, char = nil, acquireAt = 0, lastPos = nil, lastAt = 0, vel = Vector3.zero, } local AIM_LAST_PART = nil local AIM_LAST_TARGET = nil local AIM_PART_CHANGE_AT = 0 local AIM_TARGET_HOLD_UNTIL = 0 local function getAimStrengthLevel() return math.clamp(AIM_ASSIST_STRENGTH * 1000, 0, 100) end local function getAimCorrectionFactor() local level = getAimStrengthLevel() if level <= 0 then return 0 end local normalized = level / 100 return math.clamp(normalized ^ 0.82, 0, 1) end local function getBodyPartCandidates(character) local cache = UI._candCache if cache and cache.character == character and os.clock() - cache.at < 0.5 then local list = cache.list local valid = true for i = 1, #list do if list[i].part.Parent ~= character then valid = false break end end if valid then return list end end local result = {} for _, info in ipairs(AIM_BODY_PARTS) do local part = character:FindFirstChild(info.name) if part and part:IsA(__S[73]) then result[#result + 1] = {part = part, info = info} end end UI._candCache = { character = character, at = os.clock(), list = result } return result end local function getPredictedAimPosition(part, humanoid, camera) local character = part.Parent local root = character and character:FindFirstChild(__S[75]) if not root then return part.Position end local velocity = root.AssemblyLinearVelocity local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z) local speed = horizontalVelocity.Magnitude local distance = (root.Position - camera.CFrame.Position).Magnitude local lead = math.clamp( 0.008 + speed * 0.00072 + distance * 0.000024, 0.008, 0.052 ) lead = lead * AIM_TUNE.predictionScale local localCharacter = LocalPlayer.Character local localRoot = localCharacter and localCharacter:FindFirstChild(__S[75]) if localRoot then local ownVelocity = Vector3.new( localRoot.AssemblyLinearVelocity.X, 0, localRoot.AssemblyLinearVelocity.Z ) horizontalVelocity = horizontalVelocity - ownVelocity * 0.35 speed = horizontalVelocity.Magnitude end return part.Position + horizontalVelocity * lead end local function chooseMovingBodyPart(candidates, targetHorizontal, camera, localVelocity, strength) if #candidates == 0 then return nil end local screenMove = targetHorizontal:Dot(camera.CFrame.RightVector) local localScreenMove = localVelocity:Dot(camera.CFrame.RightVector) local movement = math.abs(screenMove) + math.abs(localScreenMove) * 0.35 local weights = {} local total = 0 for _, entry in ipairs(candidates) do local info = entry.info local weight = 0.55 + info.weight * 0.55 if movement > 2 then weight = weight + info.speedBias * math.clamp(movement / 24, 0, 1) * 1.35 weight = weight + info.moveBias * math.clamp(movement / 18, 0, 1) * 0.75 if screenMove > 1.5 then if string.find(info.name, __S[493]) then weight = weight + 0.45 elseif string.find(info.name, __S[494]) then weight = weight + 0.10 end elseif screenMove < -1.5 then if string.find(info.name, __S[494]) then weight = weight + 0.45 elseif string.find(info.name, __S[493]) then weight = weight + 0.10 end end else if info.name == __S[36] then weight = weight + 0.30 elseif info.name == __S[58] or info.name == __S[37] then weight = weight + 0.16 end end weight = weight * (0.72 + strength * 0.28) weights[#weights + 1] = {entry = entry, weight = math.max(weight, 0.01)} total = total + math.max(weight, 0.01) end local roll = AIM_TARGET_RNG:NextNumber(0, total) local running = 0 for _, item in ipairs(weights) do running = running + item.weight if roll <= running then return item.entry.part end end return weights[#weights].entry.part end local function getAimAssistTarget(camera) local viewport = camera.ViewportSize local screenCenter = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5) if AIM_BIND.view == __S[190] then screenCenter = UserInputService:GetMouseLocation() end local bestCharacter = nil local bestRootDistance = math.huge local bestPart = nil local radius = AIM_ASSIST_RADIUS local now = os.clock() local localCharacter = LocalPlayer.Character local localRoot = localCharacter and localCharacter:FindFirstChild(__S[75]) local localVelocity = localRoot and Vector3.new(localRoot.AssemblyLinearVelocity.X, 0, localRoot.AssemblyLinearVelocity.Z) or Vector3.zero local aimOrigin = localRoot and localRoot.Position or camera.CFrame.Position local aimSelected = UI.aimTargets.selected local aimBlacklist = UI.aimTargets.listMode == __S[56] for _, candidate in ipairs(Players:GetPlayers()) do if candidate ~= LocalPlayer and (aimSelected[candidate.UserId] == true) == aimBlacklist then local character = candidate.Character local humanoid = character and character:FindFirstChildOfClass(__S[52]) local root = character and character:FindFirstChild(__S[75]) if humanoid and root and not isTargetKnocked(character, humanoid) and (root.Position - aimOrigin).Magnitude <= AIM_ASSIST_MAX_DISTANCE then local rootPos = root.Position local rootScreen, visible = camera:WorldToViewportPoint(rootPos) if visible and rootScreen.Z > 0 then local rootDistance = (Vector2.new(rootScreen.X, rootScreen.Y) - screenCenter).Magnitude if rootDistance <= radius + 2 then local targetVelocity = root.AssemblyLinearVelocity local targetHorizontal = Vector3.new( targetVelocity.X, 0, targetVelocity.Z ) local score = rootDistance if AIM_LAST_TARGET and AIM_LAST_TARGET.Parent == character then score = score - 10 end if targetHorizontal.Magnitude > 2 then score = score - math.clamp(targetHorizontal.Magnitude * 0.06, 0, 4) end if score < bestRootDistance then bestRootDistance = score bestCharacter = character end end end end end end if bestCharacter then local humanoid = bestCharacter:FindFirstChildOfClass(__S[52]) local root = bestCharacter:FindFirstChild(__S[75]) local candidates = getBodyPartCandidates(bestCharacter) if humanoid and root and #candidates > 0 then local targetVelocity = root.AssemblyLinearVelocity local targetHorizontal = Vector3.new( targetVelocity.X, 0, targetVelocity.Z ) local selectedPart = nil local closestPartDistance = math.huge for _, entry in ipairs(candidates) do local part = entry.part local group = AIM_BIND.partGroup[part.Name] if not group or not AIM_BIND.parts[group] then continue end local partScreen, partVisible = camera:WorldToViewportPoint(part.Position) if partVisible and partScreen.Z > 0 then local partDistance = ( Vector2.new(partScreen.X, partScreen.Y) - screenCenter ).Magnitude if partDistance < closestPartDistance then closestPartDistance = partDistance selectedPart = part end end end if selectedPart then local aimPosition = getPredictedAimPosition(selectedPart, humanoid, camera) local screenPos, visible = camera:WorldToViewportPoint(aimPosition) if visible and screenPos.Z > 0 then local screenDistance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude if screenDistance <= radius + 3 then local direction = aimPosition - camera.CFrame.Position local blocked = AIM_BIND.rayThrough( camera.CFrame.Position, direction, { bestCharacter } ) if not blocked then bestPart = selectedPart AIM_LAST_TARGET = bestCharacter:FindFirstChild(__S[75]) end end end end end end if bestPart then if bestPart ~= AIM_LAST_PART then AIM_LAST_PART = bestPart local strength = getAimStrengthLevel() / 100 AIM_PART_CHANGE_AT = now + AIM_TARGET_RNG:NextNumber( 0.10 - strength * 0.025, 0.22 - strength * 0.045 ) end AIM_TARGET_HOLD_UNTIL = now + 0.14 elseif AIM_LAST_PART and now < AIM_TARGET_HOLD_UNTIL and AIM_LAST_PART.Parent then bestPart = AIM_LAST_PART end return bestPart end resetAimAssistState = function() AIM_ASSIST_TARGET = nil AIM_TUNE.lastLook = nil AIM_TUNE.lastLookChar = nil AIM_TUNE.push = 0 AIM_TUNE.releaseUntil = 0 AIM_TUNE.mouseRem = nil AIM_TUNE.mChar, AIM_TUNE.mVel, AIM_TUNE.mLastAt = nil, nil, 0 AIM_TUNE.mLastApplied, AIM_TUNE.mLastMouse, AIM_TUNE.mYieldUntil = nil, nil, 0 AIM_TUNE.sm.char, AIM_TUNE.sm.lastPos, AIM_TUNE.sm.vel = nil, nil, Vector3.zero AIM_TUNE.sm.flickUntil, AIM_TUNE.sm.wasJump = 0, false AIM_LAST_PART = nil AIM_LAST_TARGET = nil AIM_PART_CHANGE_AT = 0 AIM_TARGET_HOLD_UNTIL = 0 end AIM_TUNE.core = function(camera, targetPart, dt) if not targetPart or not targetPart.Parent then return false end local correction = getAimCorrectionFactor() if correction <= 0 then return false end local character = targetPart.Parent local humanoid = character:FindFirstChildOfClass(__S[52]) if not humanoid or isTargetKnocked(character, humanoid) then return false end local desiredPosition = getPredictedAimPosition(targetPart, humanoid, camera) local lock = correction * correction local nowT = os.clock() local grip = 1 if nowT < AIM_TUNE.releaseUntil then local left = (AIM_TUNE.releaseUntil - nowT) / AIM_TUNE.releaseTime grip = 1 - math.clamp(left, 0, 1) * 0.92 end if AIM_TUNE.lastLook and AIM_TUNE.lastLookChar == character then local camPos0 = camera.CFrame.Position local want0 = (desiredPosition - camPos0) if want0.Magnitude > 1e-3 then want0 = want0.Unit local cur0 = camera.CFrame.LookVector local errBefore = math.acos(math.clamp(AIM_TUNE.lastLook:Dot(want0), -1, 1)) local errNow = math.acos(math.clamp(cur0:Dot(want0), -1, 1)) local away = errNow - errBefore if away > 0 then AIM_TUNE.push = AIM_TUNE.push * 0.85 + away else AIM_TUNE.push = AIM_TUNE.push * 0.6 end local breakRad = math.rad(AIM_TUNE.breakAngle) * (0.5 + 0.5 * lock) if AIM_TUNE.push > breakRad and nowT >= AIM_TUNE.releaseUntil then AIM_TUNE.releaseUntil = nowT + AIM_TUNE.releaseTime AIM_TUNE.push = 0 grip = 0.08 end if away > 1e-5 then local back = math.min(away * lock * AIM_TUNE.maxResist * grip, errNow) local ax = cur0:Cross(want0) if ax.Magnitude > 1e-5 then camera.CFrame = CFrame.lookAt( camPos0, camPos0 + CFrame.fromAxisAngle(ax.Unit, back) * cur0 ) end end end end local viewport = camera.ViewportSize local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5) local screenPosition, visible = camera:WorldToViewportPoint(desiredPosition) if not visible or screenPosition.Z <= 0 then return false end local screenDelta = Vector2.new(screenPosition.X, screenPosition.Y) - center local pixelDistance = screenDelta.Magnitude if pixelDistance > AIM_ASSIST_RADIUS + 1 then return false end local deadzone = math.clamp(5.0 - correction * 3.8, 1.2, 5.0) if pixelDistance <= deadzone then return true end local cameraPosition = camera.CFrame.Position local desiredDirection = (desiredPosition - cameraPosition).Unit local currentDirection = camera.CFrame.LookVector local dot = math.clamp(currentDirection:Dot(desiredDirection), -1, 1) local angle = math.acos(dot) if angle < math.rad(0.05) then return true end local localCharacter = LocalPlayer.Character local localRoot = localCharacter and localCharacter:FindFirstChild(__S[75]) local ownVelocity = localRoot and Vector3.new(localRoot.AssemblyLinearVelocity.X, 0, localRoot.AssemblyLinearVelocity.Z) or Vector3.zero local targetRoot = character:FindFirstChild(__S[75]) if targetRoot then local targetVelocity = Vector3.new( targetRoot.AssemblyLinearVelocity.X, 0, targetRoot.AssemblyLinearVelocity.Z ) local relativeVelocity = targetVelocity - ownVelocity * 0.35 local lateral = relativeVelocity - currentDirection * relativeVelocity:Dot(currentDirection) local leadStrength = AIM_TUNE.lateralLead if lateral.Magnitude > 0.5 then desiredDirection = (desiredDirection + lateral * leadStrength).Unit dot = math.clamp(currentDirection:Dot(desiredDirection), -1, 1) angle = math.acos(dot) end end local response = math.clamp( (2.0 + correction * 18.0) * dt, 0, 0.50 ) local distanceFactor = math.clamp( pixelDistance / math.max(AIM_ASSIST_RADIUS, 1), 0, 1 ) local proximityFactor = 1 - distanceFactor local correctionAlpha = math.clamp( response * (0.17 + proximityFactor * 0.62 + correction * 0.20) + lock * (0.10 + proximityFactor * 0.16), 0, 0.52 + lock * 0.30 ) local maxAngle = math.rad(0.10 + correction * 2.35 + lock * 3.5) * math.clamp(dt * 60, 0.5, 1.5) local appliedAngle = math.min(angle * correctionAlpha, maxAngle) * grip if appliedAngle <= 0 then return true end local axis = currentDirection:Cross(desiredDirection) if axis.Magnitude < 1e-5 then return true end axis = axis.Unit local rotation = CFrame.fromAxisAngle(axis, appliedAngle) camera.CFrame = CFrame.lookAt( cameraPosition, cameraPosition + rotation * currentDirection ) return true end AIM_TUNE.smoothCore = function(camera, targetPart, dt) if not targetPart or not targetPart.Parent then return false end local correction = getAimCorrectionFactor() if correction <= 0 then return false end local character = targetPart.Parent local humanoid = character:FindFirstChildOfClass(__S[52]) if not humanoid or isTargetKnocked(character, humanoid) then return false end local S = AIM_TUNE.sm local now = os.clock() dt = math.clamp(dt or 0.016, 0.001, 0.1) local blat = math.clamp((getAimStrengthLevel() - 10) / 30, 0, 1) blat = blat * blat * (3 - 2 * blat) local flickAmt = math.min((getAimStrengthLevel() / 40) ^ 0.8, 1.8) if S.char ~= character then S.char = character S.acquireAt = now S.lastPos = nil S.vel = Vector3.zero end local root = character:FindFirstChild(__S[75]) or targetPart local rootPos = root.Position if S.lastPos then local step = now - S.lastAt if step > 0 and step < 0.25 then local inst = (rootPos - S.lastPos) / step S.vel = S.vel:Lerp(inst, 1 - math.exp(-18 * step)) else S.vel = Vector3.zero end end S.lastPos, S.lastAt = rootPos, now local jumping = S.vel.Y > S.jumpVel if jumping and not S.wasJump then S.flickUntil = now + S.flickTime * (0.6 + 0.4 * math.min(flickAmt, 1.5)) end S.wasJump = jumping local lead = S.leadTime * (0.5 + 0.5 * correction) local leadVec = Vector3.new(S.vel.X, S.vel.Y * 0.35, S.vel.Z) * lead if leadVec.Magnitude > S.maxLead then leadVec = leadVec.Unit * S.maxLead end local aimPos = targetPart.Position + leadVec local screenPos, visible = camera:WorldToViewportPoint(aimPos) if not visible or screenPos.Z <= 0 then return false end local viewport = camera.ViewportSize local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5) local pixelDistance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude if pixelDistance > AIM_ASSIST_RADIUS + 1 then return false end if pixelDistance <= 1.2 then return true end local camPos = camera.CFrame.Position local look = camera.CFrame.LookVector local want = aimPos - camPos if want.Magnitude < 1e-3 then return true end want = want.Unit local angle = math.acos(math.clamp(look:Dot(want), -1, 1)) if angle < math.rad(0.03) then return true end local yield = 1 if AIM_TUNE.lastLook and AIM_TUNE.lastLookChar == character then local prevAngle = math.acos(math.clamp(AIM_TUNE.lastLook:Dot(want), -1, 1)) local away = angle - prevAngle if away > 0 then yield = 1 - math.clamp(away / S.yieldRef, 0, 1) * 0.85 * (1 - 0.7 * blat) end end local ramp = math.clamp( (now - S.acquireAt - S.reactDelay * (1 - 0.75 * blat)) / (S.easeIn * (1 - 0.6 * blat)), 0, 1 ) ramp = ramp * ramp * (3 - 2 * ramp) local prox = 1 - 0.5 * (1 - blat) * math.clamp(pixelDistance / math.max(AIM_ASSIST_RADIUS, 1), 0, 1) local flick = (now < S.flickUntil) and flickAmt or 0 local rate = S.minRate + (S.maxRate - S.minRate) * correction + blat * S.blatRate + flick * S.flickRate local alpha = math.min((1 - math.exp(-rate * dt)) * ramp * prox * yield, 0.9) local maxStep = math.rad( S.minDeg + (S.maxDeg - S.minDeg) * correction + blat * S.blatDeg + flick * S.flickDeg ) * dt local stepAngle = math.min(angle * alpha, maxStep) if stepAngle <= 0 then return true end local axis = look:Cross(want) if axis.Magnitude < 1e-5 then return true end camera.CFrame = CFrame.lookAt( camPos, camPos + CFrame.fromAxisAngle(axis.Unit, stepAngle) * look ) return true end AIM_TUNE.mouseCore = function(camera, targetPart, dt) if not targetPart or not targetPart.Parent then return false end local correction = getAimCorrectionFactor() if correction <= 0 then return false end local character = targetPart.Parent local humanoid = character:FindFirstChildOfClass(__S[52]) if not humanoid or isTargetKnocked(character, humanoid) then return false end local desiredPosition = getPredictedAimPosition(targetPart, humanoid, camera) local camPos = camera.CFrame.Position local lookDir = camera.CFrame.LookVector local tRoot = character:FindFirstChild(__S[75]) local tVel = tRoot and Vector3.new(tRoot.AssemblyLinearVelocity.X, 0, tRoot.AssemblyLinearVelocity.Z) or Vector3.zero do local lRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(__S[75]) local ownVel = lRoot and Vector3.new(lRoot.AssemblyLinearVelocity.X, 0, lRoot.AssemblyLinearVelocity.Z) or Vector3.zero local toAim = desiredPosition - camPos local aimDist = toAim.Magnitude if aimDist > 1e-3 then local relVel = tVel - ownVel * 0.35 local lateral = relVel - lookDir * relVel:Dot(lookDir) if lateral.Magnitude > 0.5 then local dir = (toAim.Unit + lateral * AIM_TUNE.lateralLead).Unit desiredPosition = camPos + dir * aimDist end end local leadVec = tVel * (AIM_TUNE.mouseLead * (0.6 + 0.4 * correction)) if leadVec.Magnitude > AIM_TUNE.maxLeadStuds then leadVec = leadVec.Unit * AIM_TUNE.maxLeadStuds end desiredPosition = desiredPosition + leadVec end local screenPosition, visible = camera:WorldToViewportPoint(desiredPosition) if not visible or screenPosition.Z <= 0 then return false end local now = os.clock() local mouse = UserInputService:GetMouseLocation() local rawTarget = Vector2.new(screenPosition.X, screenPosition.Y) if (rawTarget - mouse).Magnitude > AIM_ASSIST_RADIUS + 1 then AIM_TUNE.mLastApplied = nil return false end if AIM_TUNE.mChar ~= character then AIM_TUNE.mChar = character AIM_TUNE.mAcquireAt = now AIM_TUNE.mVel = Vector2.zero AIM_TUNE.mSeed = math.random() * 100 AIM_TUNE.mYieldUntil = 0 end local ramp = math.clamp((now - AIM_TUNE.mAcquireAt - 0.03) / 0.12, 0, 1) ramp = ramp * ramp * (3 - 2 * ramp) local seed = AIM_TUNE.mSeed local wob = 1 + 3 * (1 - correction) local target2 = rawTarget + Vector2.new( math.noise(now * 1.3, seed, 0.5) * wob, math.noise(now * 1.1, seed, 7.3) * wob ) local toTarget = target2 - mouse local dist = toTarget.Magnitude local lastMouse = AIM_TUNE.mLastMouse if lastMouse and (now - AIM_TUNE.mLastAt) < 0.1 and dist > 1 then local userMove = (mouse - lastMouse) - (AIM_TUNE.mLastApplied or Vector2.zero) if userMove.Magnitude > 2 and userMove.Unit:Dot(toTarget.Unit) < -0.2 then AIM_TUNE.mYieldUntil = now + 0.3 end end AIM_TUNE.mLastMouse = mouse AIM_TUNE.mLastAt = now local yield = (now < AIM_TUNE.mYieldUntil) and 0.1 or 1 local deadzone = math.clamp(5 - correction * 3.5, 1.5, 5) local inDead = dist <= deadzone local lock = correction * correction local frame = math.clamp(dt * 60, 0.5, 2) local want = Vector2.zero if not inDead then local alpha = (0.08 + 0.19 * correction + 0.10 * lock) * frame * ramp * yield alpha = math.min(alpha * (1 + math.clamp(dist / 60, 0, 2)), 0.5) want = toTarget * alpha local maxStep = (5.1 + 34 * correction) * frame * yield if want.Magnitude > maxStep then want = want.Unit * maxStep end end local vel = (AIM_TUNE.mVel or Vector2.zero):Lerp(want, 0.55) AIM_TUNE.mVel = vel local ff = Vector2.zero do local stepWorld = tVel * math.clamp(dt, 0, 0.05) local ahead = camera:WorldToViewportPoint(desiredPosition + stepWorld) local ffRaw = Vector2.new(ahead.X, ahead.Y) - rawTarget if ahead.Z > 0 and ffRaw.Magnitude < 200 then ff = ffRaw * (0.8 + 0.2 * correction) * ramp * yield end end if not inDead and dist > 1 and vel.Magnitude > 0.05 then local perp = Vector2.new(-toTarget.Y, toTarget.X).Unit vel = vel + perp * (math.noise(now * 2.1, seed, 3.1) * math.min(vel.Magnitude * 0.35, 1.5)) end vel = vel + ff local rem = (AIM_TUNE.mouseRem or Vector2.zero) + vel local ix = math.modf(rem.X) local iy = math.modf(rem.Y) AIM_TUNE.mouseRem = rem - Vector2.new(ix, iy) AIM_TUNE.mLastApplied = Vector2.new(ix, iy) if ix == 0 and iy == 0 then return true end if type(mousemoverel) == __S[178] then mousemoverel(ix, iy) else pcall(function() local vim = game:GetService(__S[490]) vim:SendMouseMoveEvent(mouse.X + ix, mouse.Y + iy, game) end) end return true end local function applyAimAssistCorrection(camera, targetPart, dt) if AIM_BIND.view == __S[190] then AIM_TUNE.lastLook = nil AIM_TUNE.lastLookChar = nil return AIM_TUNE.mouseCore(camera, targetPart, dt) end local result if AIM_TUNE.style == __S[495] then result = AIM_TUNE.core(camera, targetPart, dt) else result = AIM_TUNE.smoothCore(camera, targetPart, dt) end AIM_TUNE.lastLook = camera.CFrame.LookVector AIM_TUNE.lastLookChar = targetPart and targetPart.Parent or nil return result end local function resolvePlayerFromPart(part) if not part or not part:IsA(__S[73]) then return nil, nil end local ancestor = part:FindFirstAncestorOfClass(__S[477]) while ancestor do if ancestor:IsA(__S[477]) then local candidate = Players:GetPlayerFromCharacter(ancestor) if candidate then return candidate, ancestor end end ancestor = ancestor.Parent end for _, candidate in ipairs(Players:GetPlayers()) do local candidateCharacter = candidate.Character if candidateCharacter and part:IsDescendantOf(candidateCharacter) then return candidate, candidateCharacter end end return nil, nil end local function crosshairShotTarget() local target = AIM_BIND.centerPart() or Mouse.Target local player, character = resolvePlayerFromPart(target) if not character or not player or player == LocalPlayer then return nil, nil end return player, character end fireTriggeredShot = function() if SCRIPT_KILLED or not MENU_UNLOCKED or not selectedActivator then return nil end if isLocalPlayerKnockedOrDead() then return nil end if not AIM_BIND.colorbotOn() then return nil end if AIM_BIND.ownMelee() then cancelHostTrigger() return nil end local target = AIM_BIND.centerPart() or Mouse.Target local player, character = resolvePlayerFromPart(target) if not character or not player or player == LocalPlayer then return nil end if UI.knock.colorbot and not KO_Flag(character) then cancelHostTrigger() return nil end local humanoid = character:FindFirstChildOfClass(__S[52]) if UI.mouseOverMenu() then return nil end AIM_BIND.lastOwnClick = os.clock() mouse1press() mouse1release() return player, character, humanoid end startHostBurst = function(token, fresh) if hostBurstActive then return end if not fresh and hostHasMeleeWeapon(selectedActivator) then cancelHostTrigger() return end local function runBurst(character) hostBurstActive = true hostBurstTarget = character if HOST_ROUND_TARGET == nil then HOST_ROUND_TARGET = character end task.spawn(function() while hostBurstActive do if SCRIPT_KILLED or not MENU_UNLOCKED then break end if isLocalPlayerKnockedOrDead() then stopColorbotIfDead() break end if not AIM_BIND.colorbotOn() or AIM_BIND.ownMelee() then break end if token ~= hostDelayToken then break end if hostBurstTarget and not hostBurstTarget.Parent then hostBurstTarget = nil end if UI.mouseOverMenu() then break end local onTarget = false do local _, overCharacter = crosshairShotTarget() if overCharacter then if UI.knock.colorbot and not KO_Flag(overCharacter) then onTarget = false else hostBurstTarget = overCharacter onTarget = true end elseif hostBurstTarget and not (UI.knock.colorbot and not KO_Flag(hostBurstTarget)) then onTarget = isAimedAtCharacter(workspace.CurrentCamera, hostBurstTarget, 55) end end if onTarget then local CLICKS_PER_FRAME = 6 AIM_BIND.lastOwnClick = os.clock() for _ = 1, CLICKS_PER_FRAME do mouse1press() mouse1release() end end task.wait() end pcall(mouse1release) if token == hostDelayToken then AIM_BIND.anyShotLockUntil = math.max(AIM_BIND.anyShotLockUntil or 0, os.clock() + 0.3) hostBurstActive = false hostBurstTarget = nil HOST_TRIGGER_ARMED = false activatorPulseUntil = 0 activatorFireAt = 0 AIM_ASSIST_TARGET = nil end end) end local player, character = fireTriggeredShot() if player and character then runBurst(character) return end if token ~= hostDelayToken then return end task.spawn(function() while true do task.wait() if token ~= hostDelayToken or hostBurstActive then return end if SCRIPT_KILLED or not MENU_UNLOCKED or not HOST_TRIGGER_ARMED or not AIM_BIND.colorbotOn() then cancelHostTrigger() return end local p, c = fireTriggeredShot() if p and c then runBurst(c) return end if token ~= hostDelayToken then return end end end) end UserInputService.InputBegan:Connect(function(input, gameProcessed) if TB_BIND_LISTENING then finishTriggerbotBind(input) return end updateTriggerbotKeyInput(input, true) end) UserInputService.InputEnded:Connect(function(input) updateTriggerbotKeyInput(input, false) end) UserInputService.WindowFocusReleased:Connect(function() TB_HELD = false if TB_MODE == __S[47] then TB_HELD = TB_TOGGLED end end) RunService:BindToRenderStep(__S[15], Enum.RenderPriority.Last.Value, function() if SCRIPT_KILLED or not MENU_UNLOCKED then return end pcall(stopColorbotIfDead) fireStandaloneTriggerbot() end) RunService:BindToRenderStep(__S[14], Enum.RenderPriority.Input.Value, function(dt) if SCRIPT_KILLED or not MENU_UNLOCKED then return end pcall(stopColorbotIfDead) local aimAssistActive = AIM_BIND.isActive() and not isLocalPlayerKnockedOrDead() if aimAssistActive then local assistCamera = workspace.CurrentCamera if assistCamera then if AIM_ASSIST_TARGET then local oldCharacter = AIM_ASSIST_TARGET.Parent local oldHumanoid = oldCharacter and oldCharacter:FindFirstChildOfClass(__S[52]) if not oldHumanoid or isTargetKnocked(oldCharacter, oldHumanoid) then AIM_ASSIST_TARGET = nil end end local selectedPart = getAimAssistTarget(assistCamera) if selectedPart then AIM_ASSIST_TARGET = selectedPart AIM_LAST_TARGET = selectedPart applyAimAssistCorrection(assistCamera, AIM_ASSIST_TARGET, dt) else AIM_ASSIST_TARGET = nil AIM_LAST_TARGET = nil end end else resetAimAssistState() end if not COLORBOT_ENABLED or not selectedActivator then return end end) task.defer(function() local ok, err = pcall(UI.autoload.run) if not ok then warn(__S[496] .. tostring(err)) end end)
