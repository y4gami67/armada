-- click on the SAME config within 3 seconds goes through. Anything else (waiting, changing the name) cancels it.
UI.confirmState = {}
UI.confirmArm = function(button, idleText, armedText, subject)
    local st = UI.confirmState[button]
    if not st then
        st = { token = 0, armed = false, subject = nil, color = button.TextColor3 }
        UI.confirmState[button] = st
    end
    if st.armed and st.subject == subject then
        st.armed = false
        st.token = st.token + 1
        button.Text = idleText
        button.TextColor3 = st.color
        return true
    end
    st.armed, st.subject = true, subject
    st.token = st.token + 1
    local mine = st.token
    button.Text = armedText
    button.TextColor3 = UI.Theme.accent
    task.delay(3, function()
        if st.armed and st.token == mine then
            st.armed = false
            if button.Parent then
                button.Text = idleText
                button.TextColor3 = st.color
            end
        end
    end)
    return false
end
