local WHITELIST_URL = "https://pastebin.com/raw/0K3ZqavQ"

local function loadWhitelistedUserIds()
    local whitelisted = {}

    local ok, contents = pcall(function()
        return game:HttpGet(WHITELIST_URL)
    end)

    if not ok or type(contents) ~= "string" then
        return nil
    end

    for id in string.gmatch(contents, "%d+") do
        local userId = tonumber(id)
        if userId then
            whitelisted[userId] = true
        end
    end

    return whitelisted
end
