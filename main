local HOST_DELAY_MIN_MS = 100
local HOST_DELAY_MAX_MS = 100
local HOST_DELAY_MS = 100
local HOST_ROUND_DELAY_MS = nil
local HOST_ROUND_TARGET = nil

local function chooseHostDelay()

    local minDelay = math.floor(math.clamp(HOST_DELAY_MIN_MS, 0, 1000) + 0.5)
    local maxDelay = math.floor(math.clamp(HOST_DELAY_MAX_MS, 0, 1000) + 0.5)

    if minDelay > maxDelay then
        minDelay, maxDelay = maxDelay, minDelay
    end

    if minDelay == maxDelay then
        HOST_DELAY_MS = minDelay
        return HOST_DELAY_MS
    end

    local roundRng = Random.new()
    HOST_DELAY_MS = roundRng:NextInteger(minDelay, maxDelay)
    return HOST_DELAY_MS
end

local AIM_ASSIST_ENABLED = false
local AIM_ASSIST_KEYCODE = Enum.KeyCode.C
local AIM_ASSIST_KEY_LABEL = "C"
local AIM_ASSIST_BIND_LISTENING = false
local AIM_ASSIST_RADIUS = 45
local AIM_ASSIST_STRENGTH = 0.020
local AIM_ASSIST_TARGET = nil
local speedInputMin
local speedInputMax

do
    local T = UI.Theme

    local card = UI.card(speedSection, "DelayCard", 0, 0, 560, 206, "SHOT DELAY RANGE", "Milliseconds, from 0 to 1000")

    UI.label(card, "MIN", 14, 52, 240, 14, 10, T.dim, Enum.Font.GothamBold)
    speedInputMin = UI.input(card, 14, 70, 244, 50, tostring(HOST_DELAY_MIN_MS), "Min")
    speedInputMin.TextSize = 22
    speedInputMin.Font = Enum.Font.GothamBold

    UI.label(card, "MAX", 302, 52, 240, 14, 10, T.dim, Enum.Font.GothamBold)
    speedInputMax = UI.input(card, 302, 70, 244, 50, tostring(HOST_DELAY_MAX_MS), "Max")
    speedInputMax.TextSize = 22
    speedInputMax.Font = Enum.Font.GothamBold

    UI.label(card, "to", 258, 70, 44, 50, 11, T.dim, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)

    local track = UI.new("Frame", {
        Position = UDim2.fromOffset(14, 144),
        Size = UDim2.fromOffset(532, 8),
        BackgroundColor3 = T.field,
        BorderSizePixel = 0,
    }, card)
    UI.corner(track, 4)
    UI.stroke(track, T.stroke, 1, 0)

    local fill = UI.new("Frame", {
        Size = UDim2.new(0.1, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    UI.corner(fill, 4)
    UI.new("UIGradient", { Color = ColorSequence.new(T.accent, T.accent2) }, fill)

    UI.label(card, "0", 14, 158, 60, 14, 9, T.dim, Enum.Font.GothamMedium)
    UI.label(card, "1000 ms", 486, 158, 60, 14, 9, T.dim, Enum.Font.GothamMedium, Enum.TextXAlignment.Right)

    local summary = UI.label(card, "", 14, 174, 532, 22, 12, T.sub, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)

    local function updateRange()
        local lo = tonumber(speedInputMin.Text) or HOST_DELAY_MIN_MS
        local hi = tonumber(speedInputMax.Text) or HOST_DELAY_MAX_MS
        lo = math.clamp(lo, 0, 1000)
        hi = math.clamp(hi, 0, 1000)
        if lo > hi then
            lo, hi = hi, lo
        end
        local a, b = lo / 1000, hi / 1000
        fill.Position = UDim2.new(a, 0, 0, 0)
        fill.Size = UDim2.new(math.max(b - a, 0.006), 0, 1, 0)
        summary.Text = string.format("%d - %d ms", math.floor(lo + 0.5), math.floor(hi + 0.5))
    end

    speedInputMin:GetPropertyChangedSignal("Text"):Connect(updateRange)
    speedInputMax:GetPropertyChangedSignal("Text"):Connect(updateRange)
    updateRange()

    local tip = UI.card(speedSection, "DelayTip", 0, 218, 560, 74, "HOW IT WORKS")
    local tipText = UI.label(tip, "A new random value inside this range is picked every round.", 26, 34, 520, 28, 11, T.sub, Enum.Font.Gotham)
    tipText.TextWrapped = true
    tipText.TextYAlignment = Enum.TextYAlignment.Top
end

local function applyHostDelay()
    local minValue = tonumber(speedInputMin.Text)
    local maxValue = tonumber(speedInputMax.Text)

    if minValue == nil then
        minValue = HOST_DELAY_MIN_MS
    end
    if maxValue == nil then
        maxValue = HOST_DELAY_MAX_MS
    end

    if minValue ~= minValue or maxValue ~= maxValue
        or minValue == math.huge or maxValue == math.huge
        or minValue == -math.huge or maxValue == -math.huge then
        minValue = HOST_DELAY_MIN_MS
        maxValue = HOST_DELAY_MAX_MS
    end

    minValue = math.floor(math.clamp(minValue, 0, 1000) + 0.5)
    maxValue = math.floor(math.clamp(maxValue, 0, 1000) + 0.5)

    if minValue > maxValue then
        minValue, maxValue = maxValue, minValue
    end

    HOST_DELAY_MIN_MS = minValue
    HOST_DELAY_MAX_MS = maxValue
    speedInputMin.Text = tostring(HOST_DELAY_MIN_MS)
    speedInputMax.Text = tostring(HOST_DELAY_MAX_MS)

end

speedInputMin.FocusLost:Connect(applyHostDelay)
speedInputMax.FocusLost:Connect(applyHostDelay)

