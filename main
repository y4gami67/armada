local Players = game:GetService("Players") local RunService = game:GetService("RunService") local UserInputService = game:GetService("UserInputService") local CoreGui = game:GetService("CoreGui") local TweenService = game:GetService("TweenService") local HttpService = game:GetService("HttpService") local LocalPlayer = Players.LocalPlayer local Mouse = LocalPlayer:GetMouse() local __ARMADA_CACHE = "armada_wl_" .. tostring(LocalPlayer.UserId) .. ".dat"
local __ARMADA_GRACE = 7 * 24 * 3600
local function __armadaSig(uid, t)
	local h = 5381
	local str = tostring(uid) .. ":" .. tostring(t) .. ":armada-wl"
	for i = 1, #str do h = (h * 33 + str:byte(i)) % 4294967296 end
	return h
end
local function __armadaSaveVerified()
	if type(writefile) ~= "function" then return end
	local t = os.time()
	pcall(writefile, __ARMADA_CACHE, tostring(LocalPlayer.UserId) .. "|" .. tostring(t) .. "|" .. tostring(__armadaSig(LocalPlayer.UserId, t)))
end
local function __armadaCachedOk()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then return false end
	local okExists, exists = pcall(isfile, __ARMADA_CACHE)
	if not okExists or not exists then return false end
	local okRead, raw = pcall(readfile, __ARMADA_CACHE)
	if not okRead or type(raw) ~= "string" then return false end
	local uid, t, sig = raw:match("^(%d+)|(%d+)|(%d+)%s*$")
	uid, t, sig = tonumber(uid), tonumber(t), tonumber(sig)
	if not uid or not t or not sig or uid ~= LocalPlayer.UserId then return false end
	if sig ~= __armadaSig(uid, t) then return false end
	local age = os.time() - t
	return age >= -300 and age <= __ARMADA_GRACE
end
local function __armadaHttp(url)
	local ok, body = pcall(function() return game:HttpGet(url, true) end)
	if ok and type(body) == "string" and body ~= "" then return body end
	ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and type(body) == "string" and body ~= "" then return body end
	local req = (type(syn) == "table" and syn.request) or (type(http_request) == "function" and http_request) or (type(request) == "function" and request) or (type(http) == "table" and http.request) or nil
	if req then
		local okReq, res = pcall(req, { Url = url, Method = "GET" })
		if okReq and type(res) == "table" and (res.StatusCode == nil or res.StatusCode == 200) and type(res.Body) == "string" and res.Body ~= "" then
			return res.Body
		end
	end
	return nil
end
local function __armadaParse(body)
	if type(body) ~= "string" or body == "" then return nil end
	local head = body:sub(1, 300):lower()
	if head:find("<!doctype", 1, true) or head:find("<html", 1, true) or head:find("rate limit", 1, true) or head:find("too many requests", 1, true) or head:sub(1, 4) == "404:" or head:sub(1, 4) == "429:" then return nil end
	local ids, count = {}, 0
	for n in string.gmatch(body, "%d+") do
		local id = tonumber(n)
		if id then
			ids[id] = true
			count = count + 1
		end
	end
	if count == 0 then return nil end
	return ids
end
local function __armadaGate(fresh)
	local q = { 104,116,116,112,115,58,47,47,103,105,115,116,46,103,105,116,104,117,98, 117,115,101,114,99,111,110,116,101,110,116,46,99,111,109,47,121,52,103, 97,109,105,54,55,47,56,55,98,50,97,97,102,101,99,54,50,57,102, 48,50,56,100,101,53,97,102,100,49,56,50,57,98,102,101,101,48,55, 47,114,97,119,47,119,104,105,116,101,108,105,115,116,46,116,120,116 }
	local base = string.char(table.unpack(q))
	local user, gistId, fileName = base:match("githubusercontent%.com/([^/]+)/([^/]+)/raw/([^/]+)$")
	local started = os.clock()
	for attempt = 1, 4 do
		if attempt > 1 and os.clock() - started > 25 then break end
		local bust = "?cb=" .. tostring(os.time()) .. tostring(attempt)
		local urls = {}
		if fresh or attempt > 1 then urls[#urls + 1] = base .. bust end
		urls[#urls + 1] = base
		if user and gistId and fileName then
			urls[#urls + 1] = "https://gist.github.com/" .. user .. "/" .. gistId .. "/raw/" .. fileName .. (attempt > 1 and bust or "")
		end
		for _, url in ipairs(urls) do
			if os.clock() - started > 40 then break end
			local ids = __armadaParse(__armadaHttp(url))
			if ids then return ids end
		end
		if attempt < 4 then task.wait(attempt) end
	end
	if gistId and fileName then
		local body = __armadaHttp("https://api.github.com/gists/" .. gistId)
		if body then
			local okJson, data = pcall(function() return HttpService:JSONDecode(body) end)
			local file = okJson and type(data) == "table" and type(data.files) == "table" and data.files[fileName]
			if type(file) == "table" and type(file.content) == "string" then
				local ids = __armadaParse(file.content)
				if ids then return ids end
			end
		end
	end
	return nil
end

