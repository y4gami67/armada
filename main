so", RightArm = "Right Arm", LeftArm = "Left Arm", RightLeg = "Right Leg", LeftLeg = "Left Leg", } UI.aimHook = UI.aimHook or {} local function drawAim() local hook = UI.aimHook if not hook.isOn then return end local names = {} for _, name in ipairs(PART_ORDER) do local on = hook.isOn(name) tween(aimParts[name], 0.12, { BackgroundColor3 = on and T.accent or T.card2 }) if on then names[#names + 1] = AIM_NICE[name] end end aimCaption.Text = #names > 0 and ("Targeting: " .. table.concat(names, ", ")) or "Targeting: nothing selected" end for _, name in ipairs(PART_ORDER) do local b = aimParts[name] b.MouseEnter:Connect(function() if UI.aimHook.isOn and not UI.aimHook.isOn(name) then tween(b, 0.1, { BackgroundColor3 = T.stroke }) end end) b.MouseLeave:Connect(function() drawAim() end) b.MouseButton1Click:Connect(function() if dead() then return end if UI.aimHook.toggle then UI.aimHook.toggle(name) end drawAim() end) end UI.drawAimPreview = drawAim function shell.setPreviewMode(mode) if mode == "esp" then preview.Visible = true espBody.Visible, aimBody.Visible = true, false previewTitle.Text = "ESP Preview" drawEsp() elseif mode == "aim" then preview.Visible = true espBody.Visible, aimBody.Visible = false, true previewTitle.Text = "Parts" drawAim() else preview.Visible = false end end UI.refreshPreview = function() if preview.Visible then if espBody.Visible then drawEsp() end if aimBody.Visible then drawAim() end end end local tabs, tabList, currentTab = {}, {}, nil shell._tabInfo = {} function shell.relayoutTabs() local info = shell._tabInfo local sum = 0 for _, ti in ipairs(info) do sum = sum + ti.tw end local pad = math.clamp((WIN_W - 28 - sum) / math.max(#info, 1), 4, 24) local x = 14 for _, ti in ipairs(info) do local w = math.floor(ti.tw + pad) ti.btn.Position = UDim2.fromOffset(x, 3) ti.btn.Size = UDim2.fromOffset(w, TAB_H - 6) x = x + w end end function shell.addGroup(label) end function shell.pinNavToBottom(count) end function shell.selectSub(tabName, subName) local t = tabs[tabName] if not t or not subName or not t.subs[subName] then return end W.closePopup() t.activeSub = subName for n, s in pairs(t.subs) do local on = (n == subName) s.sf.Visible = on s.btn.TextColor3 = on and T.accent or T.dim end end function shell.select(name, subName) local t = tabs[name] if not t then return end W.closePopup() currentTab = name for n, tab in pairs(tabs) do local on = (n == name) tab.container.Visible = on tab.btn.BackgroundTransparency = on and 0 or 1 tab.st.Transparency = on and 0.4 or 1 tab.btn.TextColor3 = on and UI.btn.text or T.sub end shell.setPreviewMode(t.preview) shell.selectSub(name, subName or t.activeSub or t.firstSub) end function shell.addTab(name, iconKind, previewMode) local index = #tabList + 1 local tw = math.ceil(UI.textWidth(name, 11, GB)) local w = tw + 16 local btn = new("TextButton", { Name = "Tab_" .. name, Position = UDim2.fromOffset(8, 3), Size = UDim2.fromOffset(w, TAB_H - 6), BackgroundColor3 = UI.btn.sel, BackgroundTransparency = 1, Text = name, TextColor3 = T.sub, TextSize = 11, Font = GB, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 4, }, tabBar) shell._tabInfo[#shell._tabInfo + 1] = { btn = btn, tw = tw } shell.relayoutTabs() local st = stroke(btn, T.stroke, 1, 1) corner(btn, 9) local container = new("Frame", { Name = "Container_" .. name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 2, }, contentFade) local subBar = new("Frame", { Name = "SubBar", Size = UDim2.new(1, 0, 0, SUB_BAR_H), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4, }, container) new("Frame", { Position = UDim2.fromOffset(0, SUB_BAR_H + 3), Size = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 0.45, BackgroundColor3 = T.stroke, BorderSizePixel = 0, ZIndex = 3, Active = false, }, container) local tab = { btn = btn, st = st, container = container, subBar = subBar, subs = {}, subX = 0, preview = previewMode, activeSub = nil, firstSub = nil, } tabs[name] = tab tabList[index] = name btn.MouseButton1Click:Connect(function() if dead() then return end shell.select(name) end) btn.MouseEnter:Connect(function() if currentTab ~= name then btn.TextColor3 = T.text end end) btn.MouseLeave:Connect(function() if currentTab ~= name then btn.TextColor3 = T.sub end end) return tab end function shell.addSub(tabName, subName, noScroll) local t = tabs[tabName] if not t then error("unknown tab: " .. tostring(tabName)) end local w = math.floor(UI.textWidth(subName, 12, GB)) + 26 local b = new("TextButton", { Name = "Sub_" .. subName, Position = UDim2.fromOffset(t.subX, 0), Size = UDim2.fromOffset(w, SUB_BAR_H), BackgroundTransparency = 1, Text = subName, TextColor3 = T.dim, TextSize = 12, Font = GB, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 4, }, t.subBar) t.subX = t.subX + w local sf = new("ScrollingFrame", { Name = "Page_" .. tabName .. "_" .. subName, Position = UDim2.fromOffset(0, SUB_TOP), Size = UDim2.new(1, 0, 1, -SUB_TOP), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = T.accent, ScrollBarImageTransparency = 0.35, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Active = true, ElasticBehavior = Enum.ElasticBehavior.Never, ZIndex = 2, }, t.container) new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, sf) new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 0), PaddingRight = UDim.new(0, 8), }, sf) t.subs[subName] = { btn = b, sf = sf } if not t.firstSub then t.firstSub = subName end b.MouseButton1Click:Connect(function() if dead() then return end shell.selectSub(tabName, subName) end) b.MouseEnter:Connect(function() if t.activeSub ~= subName then b.TextColor3 = T.text end end) b.MouseLeave:Connect(function() if t.activeSub ~= subName then b.TextColor3 = T.dim end end) return { tab = tabName, sub = subName, sf = sf, order = 0, two = TWO_COL[tabName .. "/" .. subName] == true, colH = { 0, 0 }, colIdx = 1 } end local function makePanel(page) local parent = page.sf if page.two then if not page.cols then page.order = page.order + 1 local block = new("Frame", { Name = "Cols", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = page.order, ZIndex = 2, }, page.sf) new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top, }, block) page.cols = {} for i = 1, 2 do local c = new("Frame", { Name = "Col" .. i, Size = UDim2.new(0.5, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = i, ZIndex = 2, }, block) new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, c) page.cols[i] = c end end local i = (page.colH[2] < page.colH[1]) and 2 or 1 page.colIdx = i parent = page.cols[i] else page.colIdx = 1 end page.order = page.order + 1 local panel = new("Frame", { Name = "Panel", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.panel, BorderSizePixel = 0, LayoutOrder = page.order, ZIndex = 2, }, parent) corner(panel, 10) stroke(panel, T.stroke, 1, 0.55) new("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder }, panel) new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), }, panel) page.panel = panel page.colH[page.colIdx] = page.colH[page.colIdx] + 20 return panel end local function row(page, h) if not page.panel then makePanel(page) end page.order = page.order + 1 page.colH[page.colIdx] = page.colH[page.colIdx] + h return new("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = page.order, ZIndex = 2, }, page.panel) end W.row = row W.makePanel = makePanel UI._notifyToken = 0 function UI.notify(title, text) UI._notifyToken = UI._notifyToken + 1 local mine = UI._notifyToken local old = whitelistGui:FindFirstChild("ArmadaNotify") if old then old:Destroy() end title, text = tostring(title or ""), tostring(text or "") local textH = 12 local okH, bounds = pcall(function() return UI.TextService:GetTextSize(text, 10, GM, Vector2.new(224, 1000)) end) if okH and bounds then textH = math.max(12, bounds.Y) end local boxH = math.max(60, 32 + textH + 10) local box = new("Frame", { Name = "ArmadaNotify", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 320, 1, -20), Size = UDim2.fromOffset(292, boxH), BackgroundColor3 = T.bg, BorderSizePixel = 0, Active = false, ZIndex = 200, }, whitelistGui) corner(box, 10) stroke(box, T.stroke, 1, 0.1) local ico = new("Frame", { Position = UDim2.fromOffset(16, 16), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 202, Active = false, }, box) corner(ico, 13) stroke(ico, T.accent, 1.5, 0) local inner = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 203, Active = false, }, ico) corner(inner, 7) stroke(inner, T.accent, 1, 0.45) local dot = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = T.accent, BorderSizePixel = 0, ZIndex = 204, Active = false, }, ico) corner(dot, 2) local t = UI.label(box, title, 56, 10, 224, 18, 12, T.accent, GB) t.TextTruncate = Enum.TextTruncate.AtEnd t.ZIndex = 202 local m = UI.label(box, text, 56, 30, 224, textH + 4, 10, T.sub, GM) m.TextWrapped = true m.TextYAlignment = Enum.TextYAlignment.Top m.ZIndex = 202 tween(box, 0.25, { Position = UDim2.new(1, -20, 1, -20) }) task.delay(math.clamp(3 + #text / 38, 4, 10), function() if mine ~= UI._notifyToken or not box.Parent then return end tween(box, 0.25, { Position = UDim2.new(1, 320, 1, -20) }) task.delay(0.3, function() if box.Parent and mine == UI._notifyToken then box:Destroy() end end) end) end local openPopup = nil function W.closePopup() if openPopup then openPopup:Destroy() openPopup = nil end end local function toLocal(absPos) local sc = cardScale.Scale local origin = popupLayer.AbsolutePosition return Vector2.new((absPos.X - origin.X) / sc, (absPos.Y - origin.Y) / sc) end local activeDrag = nil UserInputService.InputChanged:Connect(function(input) if activeDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then activeDrag(pointerOf(input)) end end) UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then activeDrag = nil end end) local function beginDrag(fn, input) activeDrag = fn fn(pointerOf(input)) end local function isPress(input) return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch end function W.pill(lbl) return lbl end UI.cardStyles = { Subtle = { color = T.card, row = 0.1, section = 0.1, stroke = 0 } } UI.cardStyle = "Subtle" UI._cards = {} function UI.styleCard(entry) local st = UI.cardStyles[UI.cardStyle] entry.inst.BackgroundColor3 = T.card entry.inst.BackgroundTransparency = (entry.kind == "section") and st.section or st.row if entry.stroke then entry.stroke.Transparency = st.stroke entry.stroke.Color = T.stroke end end function UI.registerCard(inst, kind, strokeObj) local entry = { inst = inst, kind = kind, stroke = strokeObj } UI._cards[#UI._cards + 1] = entry UI.styleCard(entry) return entry end function UI.applyCardStyle(name) UI.cardStyle = "Subtle" for _, entry in ipairs(UI._cards) do if entry.inst.Parent then UI.styleCard(entry) end end end UI.info = { ["Colorbot/Host/Enabled"] = "T