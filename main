        local function updateTBCheckbox(option, player, selected)
            local box = option:FindFirstChild("CheckBox")
            if not box then return end
            option.BackgroundColor3 = selected and T.soft or T.card
            local rowStroke = option:FindFirstChildOfClass("UIStroke")
            if rowStroke then rowStroke.Color = selected and T.accent or T.stroke end
            box.BackgroundColor3 = selected and T.accent or T.field
            local mark = box:FindFirstChild("Mark")
            if mark then mark.Visible = selected end
        end

        local function rebuildTBList()
            for _, child in ipairs(playerList:GetChildren()) do
                if child:IsA("GuiButton") then child:Destroy() end
            end

            local q = string.lower(search.Text or "")
            local selectedCount = 0
            for _, isSelected in pairs(TB_SELECTED) do
                if isSelected == true then
                    selectedCount += 1
                end
            end
            selectionStatus.Text = tostring(selectedCount) .. " SELECTED"

            local players = Players:GetPlayers()
            table.sort(players, function(a,b) return a.Name:lower() < b.Name:lower() end)

            for _, plr in ipairs(players) do
                if plr ~= LocalPlayer then
                    local haystack = string.lower(plr.Name .. " " .. plr.DisplayName)
                    if q == "" or haystack:find(q, 1, true) then
                        local selected = TB_SELECTED[plr.UserId] == true
                        local option = Instance.new("TextButton")
                        option.Name = "TBOption_" .. plr.UserId
                        option.Size = UDim2.new(1, -2, 0, 40)
                        option.BackgroundColor3 = selected and T.soft or T.card
                        option.BorderSizePixel = 0
                        option.Text = ""
                        option.AutoButtonColor = false
                        option.Parent = playerList
                        UI.corner(option, 8)
                        UI.stroke(option, selected and T.accent or T.stroke, 1, 0)

                        local chip = UI.new("Frame", {
                            Position = UDim2.new(0, 8, 0.5, -13),
                            Size = UDim2.fromOffset(26, 26),
                            BackgroundColor3 = T.card2,
                            BorderSizePixel = 0,
                        }, option)
                        UI.corner(chip, 13)
                        UI.label(chip, string.upper(string.sub(plr.DisplayName, 1, 1)), 0, 0, 26, 26, 11, T.sub, Enum.Font.GothamBold, Enum.TextXAlignment.Center)

                        local nameLabel = UI.label(option, plr.DisplayName, 44, 5, 190, 16, 12, T.text, Enum.Font.GothamBold)
                        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
                        local handleLabel = UI.label(option, "@" .. plr.Name, 44, 21, 190, 13, 9, T.dim, Enum.Font.Gotham)
                        handleLabel.TextTruncate = Enum.TextTruncate.AtEnd

                        local box = Instance.new("Frame")
                        box.Name = "CheckBox"
                        box.Size = UDim2.fromOffset(20, 20)
                        box.Position = UDim2.new(1, -30, 0.5, -10)
                        box.BackgroundColor3 = selected and T.accent or T.field
                        box.BorderSizePixel = 0
                        box.Parent = option
                        UI.corner(box, 6)
                        UI.stroke(box, selected and T.accent or T.stroke, 1, 0)

                        local mark = Instance.new("TextLabel")
                        mark.Name = "Mark"
                        mark.Size = UDim2.fromScale(1, 1)
                        mark.BackgroundTransparency = 1
                        mark.Text = "✓"
                        mark.TextColor3 = Color3.fromRGB(0, 0, 0)
                        mark.Font = Enum.Font.GothamBold
                        mark.TextSize = 13
                        mark.Visible = selected
                        mark.Parent = box

                        option.MouseButton1Click:Connect(function()
                            if SCRIPT_KILLED or not MENU_UNLOCKED then return end
                            TB_SELECTED[plr.UserId] = not TB_SELECTED[plr.UserId]
                            rebuildTBList()
                        end)
                    end
                end
            end
            refreshListCanvas()
        end
        TB_LIST_REBUILD = rebuildTBList
        search:GetPropertyChangedSignal("Text"):Connect(rebuildTBList)
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshListCanvas)

        local function refreshMode()
            modeButton.Text = string.upper(TB_LIST_MODE)
            modeButton.BackgroundColor3 = TB_LIST_MODE == "Whitelist" and T.accent or T.card2
        end
        modeButton.MouseButton1Click:Connect(function()

            local wasEnabled = TRIGGERBOT_ENABLED
            TB_LIST_MODE = TB_LIST_MODE == "Whitelist" and "Blacklist" or "Whitelist"
            refreshMode()
            TRIGGERBOT_ENABLED = wasEnabled
            if TB_PAGE_REFRESH then TB_PAGE_REFRESH() end
        end)
        refreshMode()

        local keyCard = UI.card(
            keyPage, "TriggerbotKeyCard", 0, 0, 560, 124,
            "TRIGGER KEY", "Click the box, then press a key or mouse button"
        )

        local keyButton = UI.button(keyCard, 14, 56, 532, 52, TB_KEY_LABEL, "default")
        keyButton.TextSize = 16

        local keyOutline = keyButton:FindFirstChildOfClass("UIStroke")
        keyButton:GetPropertyChangedSignal("Text"):Connect(function()
            if keyOutline then
                local listening = (keyButton.Text == "PRESS A KEY...")
                UI.tween(keyOutline, 0.15, {
                    Color = listening and T.accent or T.stroke
                })
            end
        end)

        keyButton.MouseButton1Click:Connect(function()
            if SCRIPT_KILLED or not MENU_UNLOCKED then return end
            TB_BIND_LISTENING = true
            if TB_PAGE_REFRESH then TB_PAGE_REFRESH() end
        end)

        local modeCard = UI.card(
            keyPage, "TriggerbotModeCard", 0, 136, 560, 134,
            "TRIGGER MODE", "How the trigger key behaves"
        )

        local descriptions = {
            Hold = "Active only while the key is held down",
            Toggle = "Press once to enable, again to disable",
        }

        for i, mode in ipairs({"Hold", "Toggle"}) do
