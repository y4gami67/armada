then return Vector2.new(input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y) end return UserInputService:GetMouseLocation() end local dimLayer = new("Frame", { Name = "DimLayer", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, ZIndex = 1, }, whitelistGui) wlCard = new("Frame", { Name = "WhitelistPanel", Size = UDim2.fromOffset(WIN_W, WIN_H), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, ZIndex = 10, }, whitelistGui) local cardScale = new("UIScale", { Scale = 1 }, wlCard) shell.scale = cardScale local function fitScale() local vp = whitelistGui.AbsoluteSize if vp.X < 10 or vp.Y < 10 then return end local s = math.min( 1, (vp.X / 2 - 12) / (WIN_W / 2 + 12 + PREVIEW_W), (vp.Y - 24) / WIN_H ) cardScale.Scale = math.max(0.45, s) end whitelistGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitScale) fitScale() local panels = {} local function makeGlass(parent, name, w, h, x, y) local f = new("Frame", { Name = name, Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundColor3 = T.bg, BackgroundTransparency = 0, BorderSizePixel = 0, Active = true, ZIndex = 1, }, parent) corner(f, 12) local st = stroke(f, T.stroke, 1, 0.15) local entry = { frame = f, stroke = st } panels[#panels + 1] = entry return f, entry end function shell.applyGlass() local t = math.clamp(glass.level, 0, 60) / 100 for _, p in ipairs(panels) do if p.frame and p.frame.Parent then p.frame.BackgroundTransparency = t end end end local function line(parent, x1, y1, x2, y2, color, th, z) local dx, dy = x2 - x1, y2 - y1 local len = math.sqrt(dx * dx + dy * dy) return new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2), Size = UDim2.fromOffset(len, th), Rotation = math.deg(math.atan2(dy, dx)), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z or 3, Active = false, }, parent) end shell.line = line local GLOW_STEPS, GLOW_STEP = 20, 2 local glowRings = {} function shell.applyGlow() local k = math.clamp(glass.glow, 0, 100) / 100 for _, g in ipairs(glowRings) do if g.stroke and g.stroke.Parent then g.stroke.Transparency = 1 - k * (1 - g.fade) * (1 - g.fade) g.stroke.Color = glass.glowColor end end end local function makeGlow(parent, w, h, x, y) local holder = new("Frame", { Name = "ThemeGlow", Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, ZIndex = 0, }, parent) for i = 1, GLOW_STEPS do local inset = (i - 1) * GLOW_STEP local ring = new("Frame", { Position = UDim2.fromOffset(-inset, -inset), Size = UDim2.fromOffset(w + inset * 2, h + inset * 2), BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, ZIndex = 0, }, holder) corner(ring, 12 + inset) local fade = (i - 1) / GLOW_STEPS local gst = new("UIStroke", { Color = glass.glowColor, Thickness = GLOW_STEP, Transparency = 1 - (glass.glow / 100) * (1 - fade) * (1 - fade), ApplyStrokeMode = Enum.ApplyStrokeMode.Border, }, ring) glowRings[#glowRings + 1] = { stroke = gst, fade = fade } end return holder end local windowGlow = makeGlow(wlCard, WIN_W, WIN_H, 0, 0) local win, winEntry = makeGlass(wlCard, "Window", WIN_W, WIN_H, 0, 0) shell.window = win win.Size = UDim2.new(0, WIN_W, 1, 0) local header = new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, TOP_H), BackgroundTransparency = 1, BorderSizePixel = 0, Active = true, ZIndex = 3, }, win) UI.b64decode = function(data) local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" local lookup = {} for i = 1, 64 do lookup[chars:sub(i, i)] = i - 1 end data = data:gsub("[^%w%+/=]", "") local out = {} for i = 1, #data, 4 do local a, b = lookup[data:sub(i, i)], lookup[data:sub(i + 1, i + 1)] local c, d = lookup[data:sub(i + 2, i + 2)], lookup[data:sub(i + 3, i + 3)] local v = a * 262144 + b * 4096 + (c or 0) * 64 + (d or 0) out[#out + 1] = string.char(math.floor(v / 65536) % 256) if c then out[#out + 1] = string.char(math.floor(v / 256) % 256) end if d then out[#out + 1] = string.char(v % 256) end end return table.concat(out) end UI.mascotB64 = "" UI.mascotAsset = function()
	if UI._mascotCached then return UI._mascotCached end
	while UI._mascotBusy do task.wait(0.05) end
	if UI._mascotCached then return UI._mascotCached end
	UI._mascotBusy = true
	local result = nil
	pcall(function()
		if type(writefile) ~= "function" or type(getcustomasset) ~= "function" then return end
		local path = "armada_mascot_v3.png"
		local data = UI.b64decode(UI.mascotB64)
		local need = true
		if type(isfile) == "function" and isfile(path) then
			if type(readfile) == "function" then
				local okr, cur = pcall(readfile, path)
				need = not (okr and type(cur) == "string" and #cur == #data)
			else
				need = false
			end
		end
		if need then pcall(writefile, path, data) end
		for _ = 1, 6 do
			local ok, asset = pcall(getcustomasset, path)
			if ok and type(asset) == "string" and asset ~= "" then
				result = asset
				return
			end
			task.wait(0.25)
		end
	end)
	UI._mascotBusy = false
	UI._mascotCached = result
	return result
end
