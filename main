local __armadaAccess = __armadaGate()
if __armadaAccess then
	if not __armadaAccess[LocalPlayer.UserId] then
		local freshList = __armadaGate(true)
		if freshList then __armadaAccess = freshList end
		if not __armadaAccess[LocalPlayer.UserId] then
			LocalPlayer:Kick("You're not whitelisted to use Armada. If you were just added, wait a few minutes, then rejoin the game and inject the script again.")
			return
		end
	end
	__armadaSaveVerified()
elseif not __armadaCachedOk() then
	LocalPlayer:Kick("Armada couldn't reach the whitelist server (this is a connection problem, NOT a whitelist removal). Please rejoin the game and inject the script again.")
	return
end
