then out[key] = src[key] end end if src.type == "2D" or src.type == "3D" or src.type == "Corner" then out.type = src.type end if type(src.limitValue) == "number" and src.limitValue == src.limitValue then out.limitValue = math.floor(math.clamp(src.limitValue, LIMIT_MIN, LIMIT_MAX) + 0.5) end if type(src.colors) == "table" then out.colors = {} for key in pairs(ESP.colors) do local c = src.colors[key] if type(c) == "table" then local r, g, b = tonumber(c[1]), tonumber(c[2]), tonumber(c[3]) if r and g and b and r == r and g == g and b == b then out.colors[key] = { math.floor(math.clamp(r, 0, 255)), math.floor(math.clamp(g, 0, 255)), math.floor(math.clamp(b, 0, 255)), } end end end end if type(src.binds) == "table" then out.binds = {} for _, key in ipairs(UI.espBindOrder) do if type(src.binds[key]) == "string" then out.binds[key] = src.binds[key] end end end return out end UI._espApply = function(cfg) if type(cfg) ~= "table" then return end for _, key in ipairs(BOOL_KEYS) do if type(cfg[key]) == "boolean" then ESP[key] = cfg[key] end end if cfg.type == "2D" or cfg.type == "3D" or cfg.type == "Corner" then ESP.type = cfg.type end if type(cfg.limitValue) == "number" then ESP.limitValue = math.floor(math.clamp(cfg.limitValue, LIMIT_MIN, LIMIT_MAX) + 0.5) end if type(cfg.colors) == "table" then for key, c in pairs(cfg.colors) do if ESP.colors[key] and type(c) == "table" then ESP.colors[key] = Color3.fromRGB(c[1], c[2], c[3]) end end end if type(cfg.binds) == "table" then for key, name in pairs(cfg.binds) do if ESP.binds[key] ~= nil and type(name) == "string" then local code = Enum.KeyCode.Unknown if name ~= "NONE" then local ok, value = pcall(function() return Enum.KeyCode[name] end) if ok and value then code = value end end ESP.binds[key] = code end end end listeningBind = false W.closePopup() UI.syncWidgets() UI.refreshPreview() end end shell.pinNavToBottom(2) do local D = UI.desync local DS = shell.addSub("Movement", "Desync") local RED = Color3.fromRGB(255, 60, 60) local TYPES = { "Velocity Desync", "Spam Void", "Custom", "Underground", "Fake Position" } local function randInt(a, b) a, b = math.floor(a), math.floor(b) if b < a then b = a end return math.random(a, b) end local function randSigned(a, b) local v = randInt(a, b) if math.random(0, 1) == 0 then v = -v end return v end local boostConn local function ensureBoostListener() if boostConn then return end local remote = UI.shotRemote() if not remote then return end boostConn = remote.OnClientEvent:Connect(function(name, shooter, handle, origin, endPos) if name ~= "ClientBullet" or not D.enabled or not D.dynamic then return end local char = LocalPlayer.Character if not char or shooter == char then return end local hrp = char:FindFirstChild("HumanoidRootPart") if hrp and typeof(endPos) == "Vector3" and (hrp.Position - endPos).Magnitude < 5 then D.boost = true end end) end local inFlight = false local function clearGhost() D.lastServerPos, D.lastSpoofVel, D.lastSpoofTime = nil, nil, nil end local function runVelocity() if D.dynamic then ensureBoostListener() end if inFlight then return end local char = LocalPlayer.Character local hrp = char and char:FindFirstChild("HumanoidRootPart") local hum = char and char:FindFirstChildOfClass("Humanoid") if not hrp or not hum or hum.Health <= 0 then return end local strength = D.strength if D.boost and D.dynamic then strength = strength * D.dynMult end D.boost = false local randomness = D.randomness if D.airOnly then local st = hum:GetState() if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then D.lastServerPos, D.lastSpoofVel, D.lastSpoofTime = hrp.Position, nil, nil return end end if D.chance < 100 and math.random(1, 100) > D.chance then D.lastServerPos, D.lastSpoofVel, D.lastSpoofTime = hrp.Position, nil, nil return end local real = hrp.AssemblyLinearVelocity local spoofed local dir = D.direction if dir == "Vertical" then spoofed = Vector3.new(0, D.vertical and randSigned(strength, strength * randomness) or 0, 0) elseif dir == "Behind" then local flat = Vector3.new(real.X, 0, real.Z) local behind = (flat.Magnitude > 1) and -flat.Unit or -hrp.CFrame.LookVector local mag = randInt(strength, strength * randomness) local y = D.vertical and randSigned(strength, strength * randomness) or 0 spoofed = Vector3.new(behind.X * mag, y, behind.Z * mag) elseif dir == "Kinematic" then local gravity = workspace.Gravity or 196.2 local scale = strength / math.max(real.Magnitude, 16) local kin = -real * scale local y = D.vertical and (kin.Y - gravity * randInt(strength, strength * randomness) / 100) or 0 spoofed = Vector3.new(kin.X, y, kin.Z) else spoofed = Vector3.new( randSigned(strength, strength * randomness), D.vertical and randSigned(strength, strength * randomness) or 0, randSigned(strength, strength * randomness) ) end D.lastSpoofVel, D.lastServerPos, D.lastSpoofTime = spoofed, hrp.Position, os.clock() hrp.AssemblyLinearVelocity = spoofed inFlight = true RunService.RenderStepped:Wait() if hrp.Parent then hrp.AssemblyLinearVelocity = real end inFlight = false end local setback = Instance.new("Part") setback.Name = "ArmadaDesyncSetback" setback.Size = Vector3.new(2, 2, 1) setback.Anchored = true setback.CanCollide = false setback.Transparency = 1 setback.CFrame = CFrame.new(0, -2000, 0) setback.Parent = workspace local VOID_TIME, NORMAL_TIME = 0.4, 0.133 local spamTimer = 0 local function voidCFrame(pos) return CFrame.new(pos + Vector3.new( math.random(-900000000, 900000000), math.random(100000000, 900000000), math.random(-900000000, 900000000))) end local function resetCamera() local char = LocalPlayer.Character local hum = char and char:FindFirstChildOfClass("Humanoid") local cam = workspace.CurrentCamera if hum and cam and cam.CameraSubject == setback then cam.CameraSubject = hum end end local tpHrp, tpReal = nil, nil pcall(function() RunService:UnbindFromRenderStep("ArmadaDesyncRestore") end) RunService:BindToRenderStep("ArmadaDesyncRestore", Enum.RenderPriority.First.Value, f