            UI.label(
                button, descriptions[mode], 16, 32, 226, 16,
                10, T.dim, Enum.Font.Gotham
            )

            button.MouseEnter:Connect(function()
                if not button:GetAttribute("Sel") then
                    UI.tween(button, 0.12, {
                        BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    })
                end
            end)
            button.MouseLeave:Connect(function()
                if not button:GetAttribute("Sel") then
                    UI.tween(button, 0.12, { BackgroundColor3 = T.card2 })
                end
            end)

            button.Activated:Connect(function()
                if SCRIPT_KILLED or not MENU_UNLOCKED then return end
                TB_MODE = mode
                TB_HELD = false
                TB_TOGGLED = false
