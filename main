    local dragging = false
    local dragStartPos
    local dragStartUDim

    local function beginDrag(input)
        if SCRIPT_KILLED then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        dragging = true
        dragStartPos = input.Position
        dragStartUDim = wlCard.Position
    end

    topBar.InputBegan:Connect(beginDrag)
    logoArea.InputBegan:Connect(beginDrag)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or SCRIPT_KILLED then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

        local delta = input.Position - dragStartPos
        wlCard.Position = UDim2.new(
            dragStartUDim.X.Scale,
            dragStartUDim.X.Offset + delta.X,
            dragStartUDim.Y.Scale,
            dragStartUDim.Y.Offset + delta.Y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
