    if not UI.confirmArm(configSaveButton, "Save", overwriting and "Overwrite? Click again" or "Click again to save", name) then
        setConfigStatus(overwriting and ('"' .. name .. '" already exists - click Save again to overwrite it') or ('Click Save again to save "' .. name .. '"'))
        return
    end
