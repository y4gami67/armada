cal function getPredictedAimPosition(part, humanoid, camera) local character = part.Parent if not character then return part.Position end return part.Position + UI.pred.offset(character) end local function chooseMovingBodyPart(candidates, targetHorizontal, camera, localVelocity, strength) if #candidates == 0 then return nil end local screenMove = targetHorizontal:Dot(camera.CFrame.RightVector) local localScreenMove = localVelocity:Dot(camera.CFrame.RightVector) local movement = math.abs(screenMove) + math.abs(localScreenMove) * 0.35 local weights = {} local total = 0 for _, entry in ipairs(candidates) do local info = entry.info local weight = 0.55 + info.weight * 0.55 if movement > 2 then weight = weight + info.speedBias * math.clamp(movement / 24, 0, 1) * 1.35 weight = weight + info.moveBias * math.clamp(movement / 18, 0, 1) * 0.75 if screenMove > 1.5 then if string.find(info.name, "Right") then weight = weight + 0.45 elseif string.find(info.name, "Left") then weight = weight + 0.10 end elseif screenMove < -1.5 then if string.find(info.name, "Left") then weight = weight + 0.45 elseif string.find(info.name, "Right") then weight = weight + 0.10 end end else if info.name == "Head" then weight = weight + 0.30 elseif info.name == "UpperTorso" or info.name == "Torso" then weight = weight + 0.16 end end weight = weight * (0.72 + strength * 0.28) weights[#weights + 1] = {entry = entry, weight = math.max(weight, 0.01)} total = total + math.max(weight, 0.01) end local roll = AIM_TARGET_RNG:NextNumber(0, total) local running = 0 for _, item in ipairs(weights) do running = running + item.weight if roll <= running then return item.entry.part end end return weights[#weights].entry.part end local function getAimAssistTarget(camera) local viewport = camera.ViewportSize local screenCenter = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5) if AIM_BIND.autoView() == "3rd Person" then screenCenter = UserInputService:GetMouseLocation() end local bestCharacter = nil local bestRootDistance = math.huge local bestPart = nil local radius = AIM_ASSIST_RADIUS local now = os.clock() local localCharacter = LocalPlayer.Character local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart") local localVelocity = localRoot and Vector3.new(localRoot.AssemblyLinearVelocity.X, 0, localRoot.AssemblyLinearVelocity.Z) or Vector3.zero local aimOrigin = localRoot and localRoot.Position or camera.CFrame.Position local aimSelected = UI.aimTargets.selected local aimBlacklist = UI.aimTargets.listMode == "Blacklist" for _, candidate in ipairs(Players:GetPlayers()) do if candidate ~= LocalPlayer and (aimSelected[candidate.UserId] == true) == aimBlacklist then local character = candidate.Character local humanoid = character and character:FindFirstChildOfClass("Humanoid") local root = character and character:FindFirstChild("HumanoidRootPart") if humanoid and root and not isTargetKnocked(character, humanoid) and (root.Position - aimOrigin).Magnitude <= AIM_ASSIST_MAX_DISTANCE then local rootPos = root.Position local rootScreen, visible = camera:WorldToViewportPoint(rootPos) if visible and rootScreen.Z > 0 then local rootDistance = (Vector2.new(rootScreen.X, rootScreen.Y) - screenCenter).Magnitude if rootDistance <= (radius + 2) then local targetVelocity = root.AssemblyLinearVelocity local targetHorizontal = Vector3.new( targetVelocity.X, 0, targetVelocity.Z ) local score = rootDistance if AIM_LAST_TARGET and AIM_LAST_TARGET.Parent == character then score = score - 10 end if targetHorizontal.Magnitude > 2 then score = score - math.clamp(targetHorizontal.Magnitude * 0.06, 0, 4) end if score < bestRootDistance then bestRootDistance = score bestCharacter = character end end end end end end if bestCharacter then local humanoid = bestCharacter:FindFirstChildOfClass("Humanoid") local root = bestCharacter:FindFirstChild("HumanoidRootPart") local candidates = getBodyPartCandidates(bestCharacter) if humanoid and root and #candidates > 0 then local targetVelocity = root.AssemblyLinearVelocity local targetHorizontal = Vector3.new( targetVelocity.X, 0, targetVelocity.Z ) local selectedPart = nil local closestPartDistance = math.huge for _, entry in ipairs(candidates) do local part = entry.part local group = AIM_BIND.partGroup[part.Name] if not group or not AIM_BIND.parts[group] then continue end local partScreen, partVisible = camera:WorldToViewportPoint(part.Position) if partVisible and partScreen.Z > 0 then local partDistance = ( Vector2.new(partScreen.X, partScreen.Y) - screenCenter ).Magnitude if partDistance < closestPartDistance then closestPartDistance = partDistance selectedPart = part end end end if selectedPart then local aimPosition = getPredictedAimPosition(selectedPart, humanoid, camera) local screenPos, visible = camera:WorldToViewportPoint(aimPosition) if visible and screenPos.Z > 0 then local screenDistance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude if screenDistance <= (radius + 3) then local direction = aimPosition - camera.CFrame.Position local blocked = AIM_BIND.rayThrough( camera.CFrame.Position, direction, { bestCharacter } ) if not blocked then bestPart = selectedPart AIM_LAST_TARGET = bestCharacter:FindFirstChild("HumanoidRootPart") end end end end end end if bestPart then if bestPart ~= AIM_LAST_PART then AIM_LAST_PART = bestPart local strength = getAimStrengthLevel() / 100 AIM_PART_CHANGE_AT = now + AIM_TARGET_RNG:NextNumber( 0.10 - strength * 0.025, 0.22 - strength * 0.045 ) end AIM_TARGET_HOLD_UNTIL = now + 0.14 elseif AIM_LAST_PART and now < AIM_TARGET_HOLD_UNTIL and AIM_LAST_PART.Parent then bestPart = AIM_LAST_PART end return bestPart end resetAimAssistState = function() AIM_ASSIST_TARGET = nil AIM_TUNE.lastLook = nil AIM_TUNE.lastLookChar = nil AIM_TUNE.push = 0 AIM_TUNE.releaseUntil = 0 AIM_TUNE.mouseRem = nil AIM_TUNE.mChar, AIM_TUNE.mVel, AIM_TUNE.mLastAt = nil, nil, 0 AIM_TUNE.mLastApplied, AIM_TUNE.mLastMouse, AIM_TUNE.mYieldUntil = nil, nil, 0 AIM_TUNE.sm.char, AIM_TUNE.sm.lastPos, AIM_TUNE.sm.vel = nil, nil, Vector3.zero AIM_TUNE.sm.flickUntil, AIM_TUNE.sm.wasJump = 0, false AIM_LAST_PART = nil AIM_LAST_TARGET = nil AIM_PART_CHANGE_AT = 0 AIM_TARGET_HOLD_UNTIL = 0 end AIM_TUNE.core = function(camera, targetPart, dt) if not targetPart or not targetPart.Parent then return false end local correction = getAimCorrectionFactor() if correction <= 0 then return false end local character = targetPart.Parent local humanoid = character:FindFirstChildOfClass("Humanoid") if not humanoid or isTargetKnocked(character, humanoid) then return false end local desiredPosition = getPredictedAimPosition(targetPart, humanoid, camera) local basePos = desiredPosition local lock = correction * correction local nowT = os.clock() local grip = 1 if nowT < AIM_TUNE.releaseUntil then local left = (AIM_TUNE.releaseUntil - nowT) / AIM_TUNE.releaseTime grip = 1 - math.clamp(left, 0, 1) * 0.92 end if AIM_TUNE.lastLook and AIM_TUNE.lastLookChar == character then local camPos0 = camera.CFrame.Position local want0 = (desiredPosition - camPos0) if want0.Magnitude > 1e-3 then want0 = want0.Unit local cur0 = camera.CFrame.LookVector local wantB = basePos - camPos0 wantB = wantB.Magnitude > 1e-3 and wantB.Unit or want0 local errBefore = math.acos(math.clamp(AIM_TUNE.lastLook:Dot(wantB), -1, 1)) local errNow = math.acos(math.clamp(cur0:Dot(wantB), -1, 1)) local away = errNow - errBefore if away > 0 then AIM_TUNE.push = AIM_TUNE.push * 0.85 + away else AIM_TUNE.push = AIM_TUNE.push * 0.6 end local breakRad = math.rad(AIM_TUNE.breakAngle) * (0.5 + 0.5 * lock) if AIM_TUNE.push > breakRad and nowT >= AIM_TUNE.releaseUntil then AIM_TUNE.releaseUntil = nowT + AIM_TUNE.releaseTime AIM_TUNE.push = 0 grip = 0.08 end if away > 1e-5 then local back = math.min(away * lock * AIM_TUNE.maxResist * grip, errNow) local ax = cur0:Cross(want0) if ax.Magnitude > 1e-5 then camera.CFrame = CFrame.lookAt( camPos0, camPos0 + CFrame.fromAxisAngle(ax.Unit, back) * cur0 ) end end end end local viewport = camera.ViewportSize local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5) local screenPosition, visible = camera:WorldToViewportPoint(desiredPosition) if not visible or screenPosition.Z <= 0 then return false end local screenDelta = Vector2.new(screenPosition.X, screenPosition.Y) - center local pixelDistance = screenDelta.Magnitude if AIM_TUNE.outside(camera, desiredPosition, center) then return false end local deadzone = math.clamp(5.0 - correction * 3.8, 1.2, 5.0) if pixelDistance <= deadzone then return true end local cameraPosition = camera.CFrame.Position local desiredDirection = (desiredPosition - cameraPosition).Unit local currentDirection = camera.CFrame.LookVector local dot = math.clamp(currentDirection:Dot(desiredDirection), -1, 1) local angle = math.acos(dot) if angle < math.rad(0.05) then return true end local response = math.clamp( (2.0 + correction * 18.0) * dt, 0, 0.50 ) local distanceFactor = math.clamp( pixelDistance / math.max(AIM_ASSIST_RADIUS, 1), 0, 1 ) local proximityFactor = 1 - distanceFactor local correctionAlpha = math.clamp( response * (0.17 + proximityFactor * 0.62 + correction * 0.20) + lock * (0.10 + proximityFactor * 0.16), 0, 0.52 + lock * 0.30 ) local maxAngle = math.rad(0.10 + correction * 2.35 + lock * 3.5) * math.clamp(dt * 60, 0.5, 1.5) local appliedAngle = math.min(angle * correctionAlpha, maxAngle) * grip if appliedAngle <= 0 then return true end local axis = currentDirection:Cross(desiredDirection) if axis.Magnitude < 1e-5 then return true end axis = axis.Unit local rotation = CFrame.fromAxisAngle(axis, appliedAngle) camera.CFrame = CFrame.lookAt( cameraPosition, cameraPosition + rotation * currentDirection ) return true end AIM_TUNE.smoothCore = function(camera, targetPart, dt) if not targetPart or not targetPart.Parent then return false end local correction = getAimCorrectionFactor() if correction <= 0 then return false end local character = targetPart.Parent local humanoid = character:FindFirstChildOfClass("Humanoid") if not humanoid or isTargetKnocked(character, humanoid) then return false end local S = AIM_TUNE.sm local now = os.clock() dt = math.clamp(dt or 0.016, 0.001, 0.1) local blat = math.clamp((getAimStrengthLevel() - 10) / 30, 0, 1) blat = blat * blat * (3 - 2 * blat) local flickAmt = math.min((getAimStrengthLevel() / 40) ^ 0.8, 1.8) if S.char ~= character then S.char = character S.acquireAt = now S.lastPos = nil S.vel = Vector3.zero end local root = character:FindFirstChild("HumanoidRootPart") or targetPart local rootPos = root.Position if S.lastPos then local step = now - S.lastAt if step > 0 and step < 0.25 then local inst = (rootPos - S.lastPos) / step S.vel = S.vel:Lerp(inst, 1 - math.exp(-18 * step)) else S.vel = Vector3.zero end end S.lastPos, S.lastAt = rootPos, now local jumping = S.vel.Y > S.jumpVel if jumping and not S.wasJump then S.flickUntil = now + S.flickTime * (0.6 + 0.4 * math.min(flickAmt, 1.5)) end S.wasJump = jumping local aimPos = targetPart.Position + UI.pred.offset(character) local screenPos, visible = camera:WorldToViewportPoint(aimPos) if not visible or screenPos.Z <= 0 then return false end local viewport = camera.ViewportSize local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5) local pixelDistance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude if AIM_TUNE.outside(camera, aimPos, center) then return false end if pixelDistance <= 1.2 then return true end local camPos = camera.CFrame.Position local look = camera.CFrame.LookVector local want = aimPos - camPos if want.Magnitude < 1e-3 then return true end want = want.Unit local angle = math.acos(math.clamp(look:Dot(want), -1, 1)) if angle < math.rad(0.03) then return true end local yield = 1 if AIM_TUNE.lastLook and AIM_TUNE.lastLookChar == character then local wantB = aimPos - camPos wantB = wantB.Magnitude > 1e-3 and wantB.Unit or want local prevAngle = math.acos(math.clamp(AIM_TUNE.lastLook:Dot(wantB), -1, 1)) local away = math.acos(math.clamp(look:Dot(wantB), -1, 1)) - prevAngle if away > 0 then yield = 1 - math.clamp(away / S.yieldRef, 0, 1) * 0.85 * (1 - 0.7 * blat) end end local ramp = math.clamp( (now - S.acquireAt - S.reactDelay * (1 - 0.75 * blat)) / (S.easeIn * (1 - 0.6 * blat)), 0, 1 ) ramp = ramp * ramp * (3 - 2 * ramp) local prox = 1 - 0.5 * (1 - blat) * math.clamp(pixelDistance / math.max(AIM_ASSIST_RADIUS, 1), 0, 1) local flick = (now < S.flickUntil) and flickAmt or 0 local rate = S.minRate + (S.maxRate - S.minRate) * correction + blat * S.blatRate + flick * S.flickRate local alpha = math.min((1 - math.exp(-rate * dt)) * ramp * prox * yield, 0.9) local maxStep = math.rad( S.minDeg + (S.maxDeg - S.minDeg) * correction + blat * S.blatDeg + flick * S.flickDeg ) * dt local stepAngle = math.min(angle * alpha, maxStep) if stepAngle <= 0 then return true end local axis = look:Cross(want) if axis.Magnitude < 1e-5 then return true end camera.CFrame = CFrame.lookAt( camPos, camPos + CFrame.fromAxisAngle(axis.Unit, stepAngle) * look ) return true end AIM_TUNE.mouseCore = function(camera, targetPart, dt) if not targetPart or not targetPart.Parent then return false end local correction = getAimCorrectionFactor() if correction <= 0 then return false end local character = targetPart.Parent local humanoid = character:FindFirstChildOfClass("Humanoid") if not humanoid or isTargetKnocked(character, humanoid) then return false end local desiredPosition = getPredictedAimPosition(targetPart, humanoid, camera) local tVel = UI.pred.velocity(character) local screenPosition, visible = camera:WorldToViewportPoint(desiredPosition) if not visible or screenPosition.Z <= 0 then return false end local now = os.clock() local mouse = UserInputService:GetMouseLocation() local rawTarget = Vector2.new(screenPosition.X, screenPosition.Y) local baseS = screenPosition if (Vector2.new(baseS.X, baseS.Y) - mouse).Magnitude > (AIM_ASSIST_RADIUS + 1) then AIM_TUNE.mLastApplied = nil return false end if AIM_TUNE.mChar ~= character then AIM_TUNE.mChar = character AIM_TUNE.mAcquireAt = now AIM_TUNE.mVel = Vector2.zero AIM_TUNE.mSeed = math.random() * 100 AIM_TUNE.mYieldUntil = 0 end local ramp = math.clamp((now - AIM_TUNE.mAcquireAt - 0.03) / 0.12, 0, 1) ramp = ramp * ramp * (3 - 2 * ramp) local seed = AIM_TUNE.mSeed local wob = 1 + 3 * (1 - correction) local target2 = rawTarget + Vector2.new( math.noise(now * 1.3, seed, 0.5) * wob, math.noise(now * 1.1, seed, 7.3) * wob ) local toTarget = target2 - mouse local dist = toTarget.Magnitude local lastMouse = AIM_TUNE.mLastMouse if lastMouse and (now - AIM_TUNE.mLastAt) < 0.1 and dist > 1 then local userMove = (mouse - lastMouse) - (AIM_TUNE.mLastApplied or Vector2.zero) if userMove.Magnitude > 2 and userMove.Unit:Dot((Vector2.new(baseS.X, baseS.Y) - mouse).Unit) < -0.2 then AIM_TUNE.mYieldUntil = now + 0.3 end end AIM_TUNE.mLastMouse = mouse AIM_TUNE.mLastAt = now local yield = (now < AIM_TUNE.mYieldUntil) and 0.1 or 1 local deadzone = math.clamp(5 - correction * 3.5, 1.5, 5) local inDead = dist <= deadzone local lock = correction * correction local frame = math.clamp(dt * 60, 0.5, 2) local want = Vector2.zero if not inDead then local alpha = (0.08 + 0.19 * correction + 0.10 * lock) * frame * ramp * yield alpha = math.min(alpha * (1 + math.clamp(dist / 60, 0, 2)), 0.5) want = toTarget * alpha local maxStep = (5.1 + 34 * correction) * frame * yield if want.Magnitude > maxStep then want = want.Unit * maxStep end end local vel = (AIM_TUNE.mVel or Vector2.zero):Lerp(want, 0.55) AIM_TUNE.mVel = vel local ff = Vector2.zero do local stepWorld = tVel * math.clamp(dt, 0, 0.05) local ahead = camera:WorldToViewportPoint(desiredPosition + stepWorld) local ffRaw = Vector2.new(ahead.X, ahead.Y) - rawTarget if ahead.Z > 0 and ffRaw.Magnitude < 200 then ff = ffRaw * (0.8 + 0.2 * correction) * ramp * yield end end if not inDead and dist > 1 and vel.Magnitude > 0.05 then local perp = Vector2.new(-toTarget.Y, toTarget.X).Unit vel = vel + perp * (math.noise(now * 2.1, seed, 3.1) * math.min(vel.Magnitude * 0.35, 1.5)) end vel = vel + ff local rem = (AIM_TUNE.mouseRem or Vector2.zero) + vel local ix = math.modf(rem.X) local iy = math.modf(rem.Y) AIM_TUNE.mouseRem = rem - Vector2.new(ix, iy) AIM_TUNE.mLastApplied = Vector2.new(ix, iy) if ix == 0 and iy == 0 then return true end if type(mousemoverel) == "function" then mousemoverel(ix, iy) else pcall(function() local vim = game:GetService("VirtualInputManager") vim:SendMouseMoveEvent(mouse.X + ix, mouse.Y + iy, game) end) end return true end local function applyAimAssistCorrection(camera, targetPart, dt) if AIM_BIND.autoView() == "3rd Person" then AIM_TUNE.lastLook = nil AIM_TUNE.lastLookChar = nil return AIM_TUNE.mouseCore(camera, targetPart, dt) end local result if AIM_TUNE.style == "Lock" then result = AIM_TUNE.core(camera, targetPart, dt) else result = AIM_TUNE.smoothCore(camera, targetPart, dt) end AIM_TUNE.lastLook = camera.CFrame.LookVector AIM_TUNE.lastLookChar = targetPart and targetPart.Parent or nil return result end local function resolvePlayerFromPart(part) if not part or not part:IsA("BasePart") then return nil, nil end local ancestor = part:FindFirstAncestorOfClass("Model") while ancestor do if ancestor:IsA("Model") then local candidate = Players:GetPlayerFromCharacter(ancestor) if candidate then return candidate, ancestor end end ancestor = ancestor.Parent end for _, candidate in ipairs(Players:GetPlayers()) do local candidateCharacter = candidate.Character if candidateCharacter and part:IsDescendantOf(candidateCharacter) then return candidate, candidateCharacter end end return nil, nil end local function crosshairShotTarget() local target = AIM_BIND.centerPart() or Mouse.Target local player, character = resolvePlayerFromPart(target) if not character or not player or player == LocalPlayer then return nil, nil end return player, character end fireTriggeredShot = function() if SCRIPT_KILLED or not MENU_UNLOCKED or not selectedActivator then return nil end if isLocalPlayerKnockedOrDead() then return nil end if not AIM_BIND.colorbotOn() then return nil end if AIM_BIND.ownMelee() then cancelHostTrigger() return nil end local target = AIM_BIND.centerPart() or Mouse.Target local player, character = resolvePlayerFromPart(target) if not character or not player or player == LocalPlayer then local _, fovPlayer, fovCharacter = UI.cb.fovTarget() if not fovCharacter then return nil, "notarget" end player, character = fovPlayer, fovCharacter end if UI.knock.colorbot and not KO_Flag(character) then cancelHostTrigger() return nil end local humanoid = character:FindFirstChildOfClass("Humanoid") if UI.mouseOverMenu() then return nil end local clickAt = os.clock() AIM_BIND.lastOwnClick = clickAt mouse1press() mouse1release() if UI.cb.log and UI.cb.armedAt then UI.cb.pushLog(UI.cb.setMs, clickAt - UI.cb.armedAt) UI.cb.armedAt = nil end return player, character, humanoid end startHostBurst = function(token, fresh) if hostBurstActive then return end local function runBurst(character, graceUntil) hostBurstActive = true hostBurstTarget = character if HOST_ROUND_TARGET == nil then HOST_ROUND_TARGET = character end task.spawn(function() local ok, err = pcall(function() while hostBurstActive do if SCRIPT_KILLED or not MENU_UNLOCKED then break end if isLocalPlayerKnockedOrDead() then stopColorbotIfDead() break end if not AIM_BIND.colorbotOn() or AIM_BIND.ownMelee() then break end if token ~= hostDelayToken then break end if hostBurstTarget and not hostBurstTarget.Parent then hostBurstTarget = nil end if UI.mouseOverMenu() then break end local onTarget = false do local _, overCharacter = crosshairShotTarget() if overCharacter then if UI.knock.colorbot and not KO_Flag(overCharacter) then onTarget = false else hostBurstTarget = overCharacter onTarget = true end elseif hostBurstTarget and not (UI.knock.colorbot and not KO_Flag(hostBurstTarget)) then onTarget = isAimedAtCharacter(workspace.CurrentCamera, hostBurstTarget, math.max(55, UI.cb.fov)) end if not onTarget and UI.cb.fov > 0 then local _, _, fovCharacter = UI.cb.fovTarget() if fovCharacter then hostBurstTarget = fovCharacter onTarget = true end end end if onTarget then if graceUntil then graceUntil = nil if UI.cb.log and UI.cb.armedAt then UI.cb.pushLog(UI.cb.setMs, os.clock() - UI.cb.armedAt) UI.cb.armedAt = nil end end local CLICKS_PER_FRAME = 6 AIM_BIND.lastOwnClick = os.clock() for _ = 1, CLICKS_PER_FRAME do mouse1press() mouse1release() end elseif graceUntil and os.clock() >= graceUntil then if target1Status then target1Status.Text = "HOST SHOT: nobody inside your crosshair / FOV radius" end if UI.cb.log and UI.cb.armedAt then UI.cb.pushLog(UI.cb.setMs, nil) UI.cb.armedAt = nil end break end task.wait() end end) if not ok then warn("[Armada] colorbot burst error: " .. tostring(err)) end pcall(mouse1release) if token == hostDelayToken then AIM_BIND.anyShotLockUntil = math.max(AIM_BIND.anyShotLockUntil or 0, os.clock() + 0.3) hostBurstActive = false hostBurstTarget = nil HOST_TRIGGER_ARMED = false activatorPulseUntil = 0 activatorFireAt = 0 AIM_ASSIST_TARGET = nil end end) end local okShot, shotPlayer, shotCharacter = pcall(fireTriggeredShot) if not okShot then warn("[Armada] colorbot shot error: " .. tostring(shotPlayer)) if token == hostDelayToken then cancelHostTrigger() end return end if shotPlayer and shotCharacter then runBurst(shotCharacter) return end if token ~= hostDelayToken then return end if shotCharacter == "notarget" then runBurst(nil, os.clock() + (UI.cb.targetGrace or 0.4)) return end if UI.cb.log and UI.cb.armedAt then UI.cb.pushLog(UI.cb.setMs, nil) UI.cb.armedAt = nil end cancelHostTrigger() end RunService.Heartbeat:Connect(function() if SCRIPT_KILLED then return end if HOST_TRIGGER_ARMED and not hostBurstActive and os.clock() > activatorFireAt + 1 then cancelHostTrigger() end end) UserInputService.InputBegan:Connect(function(input, gameProcessed) if TB_BIND_LISTENING then finishTriggerbotBind(input) return end updateTriggerbotKeyInput(input, true) end) UserInputService.InputEnded:Connect(function(input) updateTriggerbotKeyInput(input, false) end) UserInputService.WindowFocusReleased:Connect(function() TB_HELD = false if TB_MODE == "Toggle" then TB_HELD = TB_TOGGLED end end) RunService:BindToRenderStep("Triggerbot_Late", Enum.RenderPriority.Last.Value, function() if SCRIPT_KILLED or not MENU_UNLOCKED then return end pcall(stopColorbotIfDead) UI.tb.tick() end) UI.tb.beat = RunService.Heartbeat:Connect(function() if SCRIPT_KILLED then UI.tb.beat:Disconnect() return end if not MENU_UNLOCKED then return end UI.tb.tick() end) RunService:BindToRenderStep("Triggerbot_RenderStep", Enum.RenderPriority.Input.Value, function(dt) if SCRIPT_KILLED or not MENU_UNLOCKED then return end pcall(stopColorbotIfDead) local aimAssistActive = AIM_BIND.isActive() and not isLocalPlayerKnockedOrDead() if aimAssistActive then local assistCamera = workspace.CurrentCamera if assistCamera then if AIM_ASSIST_TARGET then local oldCharacter = AIM_ASSIST_TARGET.Parent local oldHumanoid = oldCharacter and oldCharacter:FindFirstChildOfClass("Humanoid") if not oldHumanoid or isTargetKnocked(oldCharacter, oldHumanoid) then AIM_ASSIST_TARGET = nil end end local selectedPart = getAimAssistTarget(assistCamera) if selectedPart then AIM_ASSIST_TARGET = selectedPart AIM_LAST_TARGET = selectedPart applyAimAssistCorrection(assistCamera, AIM_ASSIST_TARGET, dt) else AIM_ASSIST_TARGET = nil AIM_LAST_TARGET = nil end end else resetAimAssistState() end if not COLORBOT_ENABLED or not selectedActivator then return end end) task.defer(function() local ok, err = pcall(UI.autoload.run) if not ok then warn("[Armada] auto-load failed: " .. tostring(err)) end end)

-- ============================================================
-- UI ENHANCEMENTS - Avatar Display & Startup Screen
-- ============================================================

local function loadUserAvatar()
    local LocalPlayer = game:GetService("Players").LocalPlayer
    if not LocalPlayer then return end

    task.wait(0.5)

    -- Get user thumbnail
    local userId = LocalPlayer.UserId
    local displayName = LocalPlayer.DisplayName or LocalPlayer.Name

    -- Try to load avatar image
    local ok, avatarUrl = pcall(function()
        return game:GetService("Players"):GetUserThumbnailAsync(
            userId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size48x48
        )
    end)

    if ok and avatarUrl then
        -- Find the username label in top right and add avatar
        local gui = game:GetService("CoreGui"):FindFirstChild("ArmadaDesync")
        if gui then
            local titleBar = gui:FindFirstChild("Body"):FindFirstChild("TopBar")
            if titleBar then
                local avatar = Instance.new("ImageLabel")
                avatar.Name = "UserAvatar"
                avatar.Image = avatarUrl
                avatar.Size = UDim2.fromOffset(28, 28)
                avatar.Position = UDim2.new(1, -160, 0, 4)
                avatar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                avatar.BorderSizePixel = 0
                avatar.Parent = titleBar

                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 4)
                corner.Parent = avatar
            end
        end
    end
end

local function showStartupScreen()
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local LocalPlayer = game:GetService("Players").LocalPlayer
    local displayName = LocalPlayer.DisplayName or LocalPlayer.Name
    local TITLE = "Fear The Armada"

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ArmadaStartup"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 999999
    screenGui.Parent = game:GetService("CoreGui")

    -- Background
    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.Parent = screenGui

    -- Everything lives in one CanvasGroup so it can fade as a whole
    local group = Instance.new("CanvasGroup")
    group.Size = UDim2.fromScale(1, 1)
    group.BackgroundTransparency = 1
    group.GroupTransparency = 1
    group.Parent = bg

    -- Logo + title cluster, sits slightly above the middle of the screen
    local cluster = Instance.new("Frame")
    cluster.Size = UDim2.fromOffset(520, 230)
    cluster.AnchorPoint = Vector2.new(0.5, 0.5)
    cluster.Position = UDim2.fromScale(0.5, 0.42)
    cluster.BackgroundTransparency = 1
    cluster.Parent = group

    -- Pulsing ring behind the logo
    local ring = Instance.new("Frame")
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.new(0.5, 0, 0, 62)
    ring.Size = UDim2.fromOffset(132, 132)
    ring.BackgroundTransparency = 1
    ring.BorderSizePixel = 0
    ring.Parent = cluster
    local ringCorner = Instance.new("UICorner")
    ringCorner.CornerRadius = UDim.new(1, 0)
    ringCorner.Parent = ring
    local ringStroke = Instance.new("UIStroke")
    ringStroke.Color = Color3.fromRGB(255, 255, 255)
    ringStroke.Thickness = 1.5
    ringStroke.Transparency = 0.7
    ringStroke.Parent = ring

    -- Mascot image (same cached file the main window uses)
    local mascot = Instance.new("ImageLabel")
    mascot.Name = "Mascot"
    mascot.Image = ""
    mascot.Size = UDim2.fromOffset(112, 112)
    mascot.AnchorPoint = Vector2.new(0.5, 0.5)
    mascot.Position = UDim2.new(0.5, 0, 0, 62)
    mascot.BackgroundTransparency = 1
    mascot.ScaleType = Enum.ScaleType.Fit
    mascot.Visible = false
    mascot.Parent = cluster

    task.spawn(function()
        local ok, asset = pcall(UI.mascotAsset)
        if ok and asset and asset ~= "" and mascot.Parent then
            mascot.Image = asset
            mascot.Visible = true
        end
    end)

    -- Title: silver shimmer sweep + soft pulsing glow + typed-in reveal
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Text = TITLE
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 46
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Size = UDim2.new(1, 0, 0, 56)
    title.Position = UDim2.new(0, 0, 0, 148)
    title.BackgroundTransparency = 1
    title.MaxVisibleGraphemes = 0
    title.Parent = cluster

    local titleGrad = Instance.new("UIGradient")
    titleGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(110, 110, 122)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 110, 122)),
    })
    titleGrad.Offset = Vector2.new(-1, 0)
    titleGrad.Parent = title

    local titleStroke = Instance.new("UIStroke")
    titleStroke.Color = Color3.fromRGB(255, 255, 255)
    titleStroke.Thickness = 1.2
    titleStroke.Transparency = 0.8
    titleStroke.Parent = title

    -- Underline that grows out from the center
    local underline = Instance.new("Frame")
    underline.AnchorPoint = Vector2.new(0.5, 0)
    underline.Position = UDim2.new(0.5, 0, 0, 210)
    underline.Size = UDim2.fromOffset(0, 2)
    underline.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    underline.BorderSizePixel = 0
    underline.Parent = cluster
    local ulGrad = Instance.new("UIGradient")
    ulGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.1),
        NumberSequenceKeypoint.new(1, 1),
    })
    ulGrad.Parent = underline

    -- Welcome message, centered at the bottom
    local welcome = Instance.new("TextLabel")
    welcome.Text = "Welcome, " .. displayName
    welcome.Font = Enum.Font.GothamMedium
    welcome.TextSize = 18
    welcome.TextColor3 = Color3.fromRGB(205, 205, 212)
    welcome.TextTransparency = 1
    welcome.AnchorPoint = Vector2.new(0.5, 1)
    welcome.Position = UDim2.new(0.5, 0, 1, -48)
    welcome.Size = UDim2.new(1, 0, 0, 28)
    welcome.BackgroundTransparency = 1
    welcome.Parent = group

    local t0 = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not screenGui.Parent then
            conn:Disconnect()
            return
        end
        local t = os.clock() - t0
        titleGrad.Offset = Vector2.new(((t * 0.85) % 2.4) - 1.2, 0)
        titleStroke.Transparency = 0.78 + 0.1 * math.sin(t * 3)
        ringStroke.Transparency = 0.68 + 0.18 * math.sin(t * 2.2)
        ring.Size = UDim2.fromOffset(132 + 6 * math.sin(t * 2.2), 132 + 6 * math.sin(t * 2.2))
    end)

    local function tween(obj, time, props, style)
        local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
        tw:Play()
        return tw
    end

    local ok, err = pcall(function()
        tween(group, 0.5, { GroupTransparency = 0 })
        task.wait(0.45)
        for i = 1, #TITLE do
            title.MaxVisibleGraphemes = i
            task.wait(0.05)
        end
        tween(underline, 0.6, { Size = UDim2.fromOffset(240, 2) }, Enum.EasingStyle.Cubic)
        task.wait(0.15)
        tween(welcome, 0.6, { TextTransparency = 0 })
        task.wait(2.0)
        tween(group, 0.45, { GroupTransparency = 1 })
        task.wait(0.5)
        tween(bg, 0.45, { BackgroundTransparency = 1 })
        task.wait(0.5)
    end)
    if not ok then warn("[Armada] startup screen error: " .. tostring(err)) end
    if conn then conn:Disconnect() end
    screenGui:Destroy()
end

-- Show startup screen when script loads
task.spawn(showStartupScreen)

-- Load avatar when UI is ready
task.spawn(loadUserAvatar)


-- ============================================================
-- PIXEL-BASED FOV (instead of Circle/Box)
-- ============================================================

local function getTargetsInPixelRange(camera, pixelRange)
    local targets = {}
    local players = game:GetService("Players"):GetPlayers()

    for _, player in ipairs(players) do
        if player == game.Players.LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        -- Get screen positions
        local playerScreenPos = camera:WorldToViewportPoint(game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart").Position)
        local targetScreenPos = camera:WorldToViewportPoint(hrp.Position)

        -- Calculate pixel distance
        local pixelDist = Vector2.new(
            targetScreenPos.X - playerScreenPos.X,
            targetScreenPos.Y - playerScreenPos.Y
        ).Magnitude

        if pixelDist <= pixelRange then
            table.insert(targets, {
                player = player,
                character = char,
                hrp = hrp,
                distance = (hrp.Position - game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart").Position).Magnitude,
                pixelDistance = pixelDist
            })
        end
    end

    return targets
end
