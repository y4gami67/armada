        BorderSizePixel = 0,
    }, stage)
    corner(ringOuter, 122)
    local ringOuterStroke = UI.stroke(ringOuter, Color3.new(1, 1, 1), 3, 0)
    local ringOuterGradient = new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, T.accent),
