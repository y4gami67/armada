 end return nearest, nearestDistance end local function isOwnedByActivator(player, instance) local character = player and player.Character if not character or not instance then return false end if instance:IsDescendantOf(character) then return true end if instance:GetAttribute("OwnerCharacter") == player.Name then return true end if instance:IsA("Beam") then local a0 = instance.Attachment0 local a1 = instance.Attachment1 if (a0 and a0:IsDescendantOf(character)) or (a1 and a1:IsDescendantOf(character)) then return true end end if not AIM_BIND.hostHasGun(player) then return false end local position = getEffectPosition(instance) if not position then return false end if getNearestPlayerToPosition(position, 8) == player then return true end if instance:IsA("BasePart") then local size = instance.Size local cf = instance.CFrame local half if size.X >= size.Y and size.X >= size.Z then half = cf.RightVector * (size.X * 0.5) elseif size.Y >= size.Z then half = cf.UpVector * (size.Y * 0.5) else half = cf.LookVector * (size.Z * 0.5) end if getNearestPlayerToPosition(position + half, 8) == player or getNearestPlayerToPosition(position - half, 8) == player then return true end end return false end local function hostHasMeleeWeapon(player) local character = player and player.Character if not character then return false end for _, child in ipairs(character:GetChildren()) do if child:IsA("Tool") and AIM_BIND.isMeleeName(child.Name) then return true end end return false end AIM_BIND.recordSignal = function(reason) reason = tostring(reason) local kind if reason:sub(1, 4) == "host" then kind = "tracer" else kind = reason:match("^(%w+):") or "other" end local now = os.clock() local sig = AIM_BIND.sig if not sig then sig = { counts = {}, win = {}, winAt = 0, last = nil, lastAt = 0 } AIM_BIND.sig = sig end if now - sig.winAt > 0.6 then sig.win = {} sig.winAt = now end sig.counts[kind] = (sig.counts[kind] or 0) + 1 if not sig.win[kind] then sig.win[kind] = now end sig.last, sig.lastAt = reason, now end do local function pulseActivator(player, reason) if player == selectedActivator then AIM_BIND.recordSignal(reason) end local function why(msg) if reason == "bullet:remote" and player == selectedActivator and target1Status then target1Status.Text = "HOST SHOT IGNORED: " .. msg end end if SCRIPT_KILLED or not MENU_UNLOCKED or not COLORBOT_ENABLED or player ~= selectedActivator then return end if not AIM_BIND.colorbotOn() then why("your trigger key is not held / toggled on") return end if HOST_TRIGGER_ARMED then why("the previous host shot is still being handled") return end if reason ~= "bullet:remote" and AIM_BIND.detect == "Any" and os.clock() < (AIM_BIND.anyShotLockUntil or 0) then return end if isLocalPlayerKnockedOrDead() then why("you are knocked / dead") stopColorbotIfDead() return end if hostHasMeleeWeapon(player) then why("the host is holding a melee weapon") return end if AIM_BIND.ownMelee() then why("you are holding a melee weapon") cancelHostTrigger() return end local nowClock = os.clock() if reason ~= "bullet:remote" and nowClock < AIM_BIND.hostIgnoreUntil then return end if hostBurstActive then why("a burst is already running (release your trigger key to reset it)") return end if reason ~= "bullet:remote" and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end local ownWindow = UI.ownTracerGuard or 0 if reason ~= "bullet:remote" and ownWindow > 0 and (nowClock - AIM_BIND.lastOwnClick) < ownWindow then return end if not HOST_TRIGGER_ARMED then chooseHostDelay() HOST_ROUND_DELAY_MS = HOST_DELAY_MS local detectedAt = os.clock() if UI.cb.log then UI.cb.armedAt, UI.cb.setMs = detectedAt, HOST_DELAY_MS end local delaySeconds = HOST_DELAY_MS / 1000 local token = hostDelayToken + 1 hostDelayToken = token activatorFireAt = detectedAt + delaySeconds activatorPulseUntil = detectedAt HOST_TRIGGER_ARMED = true AIM_BIND.anyShotLockUntil = detectedAt + 0.6 if delaySeconds <= 0 then local okStart, errStart = pcall(startHo