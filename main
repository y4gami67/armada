    if TB_LIST_REBUILD then task.defer(TB_LIST_REBUILD) end
end)
Players.PlayerRemoving:Connect(function(player)
    TB_SELECTED[player.UserId] = nil
    if TB_LIST_REBUILD then task.defer(TB_LIST_REBUILD) end
end)

