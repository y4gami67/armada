) local aimKeyBtn = W.keybind(KEYS, "Aim Key") aimKeyBtn.Text = AIM_ASSIST_KEY_LABEL aimKeyBtn.MouseButton1Click:Connect(function() if dead() then return end AIM_ASSIST_BIND_LISTENING = true if AIM_BIND.refresh then AIM_BIND.refresh() end end) aimKeyBtn.MouseButton2Click:Connect(function() if dead() or UI.rmbGuard then return end AIM_BIND.key = nil AIM_ASSIST_KEYCODE = Enum.KeyCode.Unknown AIM_ASSIST_KEY_LABEL = "NONE" AIM_BIND.held, AIM_BIND.toggled = false, false AIM_ASSIST_BIND_LISTENING = false if AIM_BIND.refresh then AIM_BIND.refresh() end end) AIM_BIND.refresh = function() if aimKeyBtn and aimKeyBtn.Parent then aimKeyBtn.Text = AIM_ASSIST_BIND_LISTENING and "PRESS A KEY..." or AIM_ASSIST_KEY_LABEL end end W.register(function() AIM_BIND.refresh() end) W.segmented(KEYS, "Mode", { "Hold", "Toggle" }, function() return AIM_BIND.mode end, function(mode) AIM_BIND.mode = mode AIM_BIND.held = false AIM_BIND.toggled = false if resetAimAssistState then resetAimAssistState() end end) end shell.addTab("Gun Macro", "aim", nil) do local GUNS = shell.addSub("Gun Macro", "Guns") local SET = shell.addSub("Gun Macro", "Settings") local KEYS = shell.addSub("Gun Macro", "Keybinds") local new, corner, stroke, tween = UI.new, UI.corner, UI.stroke, UI.tween local WHITE = Color3.new(1, 1, 1) local GM, GR = Enum.Font.GothamMedium, Enum.Font.Gotham local CENTER, RIGHT = Enum.TextXAlignment.Center, Enum.TextXAlignment.Right local M = { enabled = false, guns = {}, delayMs = 0, method = "Default", seq = false, skipEmpty = false, key = nil, mode = "Hold", knockCheck = false, listening = false, held = false, latched = false, running = false, queue = nil, index = 0, startedAt = 0, dirty = false, conns = {}, } UI.macro = M local STALL = 2.0 local EQUIP_TIMEOUT = 0.6 local EQUIP_RETRY = 0.04 local MAX_RUN = 30 local ACK_MIN, ACK_MAX = 0.08, 0.5 local MAX_INFLIGHT = 3 local STALL_ALL = 5.0 local METHODS = { "Default", "Skip Empty", "One By One" } local rebuildSelected, rebuildAvailable, rebuildAll, process local function menuOpen() return whitelistGui.Enabled and GUNS.sf.Visible end local function gunAmmo(tool) if not tool or not tool:IsA("Tool") then return nil end local ammo = tool:FindFirstChild("Ammo") if not ammo or not tool:FindFirstChild("Handle") then return nil end return ammo end local function ownedGuns() local out, seen = {}, {} local function scan(container) if not container then return end for _, t in ipairs(container:GetChildren()) do if not seen[t.Name] and gunAmmo(t) then seen[t.Name] = true out[#out + 1] = t end end end scan(LocalPlayer.Character) scan(LocalPlayer:FindFirstChildOfClass("Backpack")) table.sort(out, function(a, b) return a.Name:lower() < b.Name:lower() end) return out end local function findGun(name) local char = LocalPlayer.Character local t = char and char:FindFirstChild(name) if t and t:IsA("Tool") then return t end local bp = LocalPlayer:FindFirstChildOfClass("Backpack") t = bp and bp:FindFirstChild(name) if t and t:IsA("Tool") then return t end return nil end local function isSelected(name) for _, n in ipairs(M.guns) do if n == name then return true end end return false end local function addGun(name) if not isSelected(name) then M.guns[#M.guns + 1] = name end end local function removeGun(name) for i, n in ipairs(M.guns) do if n == name then table.remove(M.guns, i) return end end end local function moveGunTo(name, newIndex) for i, n in ipairs(M.guns) do if n == name then table.remove(M.guns, i) table.insert(M.guns, math.clamp(newIndex, 1, #M.guns + 1), name) return end end end local function flag(be, name) local v = be:FindFirstChild(name) return v ~= nil and v.Value == true end local function canShoot(char, tool) local be = char:FindFirstChild("BodyEffects") if not be then return false end if be:FindFirstChild("Block") then return false end if not char:FindFirstChild("FULLY_LOADED_CHAR") then return false end if char:FindFirstChild("FORCEFIELD") or char:FindFirstChild("GRABBING_CONSTRAINT") or char:FindFirstChild("Christmas_Sock") then return false end if tool:GetAttribute("Cooldown") then return false end if flag(be, "Cuff") or flag(be, "Attacking") or flag(be, "K.O") or flag(be, "Grabbed") or flag(be, "Reload") or flag(be, "Dead") then return false end return true end local ackCache, ackAt = ACK_MIN, -1 local function ackTimeout() local t = os.clock() if t - ackAt < 0.5 then return ackCache end ackAt = t local ok, ping = pcall(LocalPlayer.GetNetworkPing, LocalPlayer) if not ok or type(ping) ~= "number" then ping = 0.1 end ackCache = math.clamp(ping * 2 + 0.05, ACK_MIN, ACK_MAX) return ackCache end local function sendClick() AIM_BIND.lastOwnClick = os.clock() if type(mouse1press) == "function" and type(mouse1release) == "function" then pcall(mouse1press) pcall(mouse1release) return end if type(mouse1click) == "function" then pcall(mouse1click) return end pcall(function() local p = UserInputService:GetMouseLocation() local vim = game:GetService("VirtualInputManager") vim:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 0) vim:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0) end) end local function isShotgun(name) local n = string.lower(name) return n:find("shotgun", 1, true) ~= nil or n:find("double-barrel", 1, true) ~= nil end local function disconnectAll() for _, c in ipairs(M.conns) do c:Disconnect() end M.conns = {} end local function report(g) if not g or (g.shots or 0) < 2 or not g.firstDropAt or g.lastDropAt <= g.firstDropAt then return end local rate = (g.shots - 1) / (g.lastDropAt - g.firstDropAt) local ok, ping = pcall(LocalPlayer.GetNetworkPing, LocalPlayer) print(string.format("[Armada] gun macro %s: %d shots, %.1f shots/s, ping %d ms", g.name, g.shots, rate, (ok and type(ping) == "number") and math.floor(ping * 1000 + 0.5) or -1)) end local function reportRun() local s = M.stats if not s or s.shots < 2 or s.lastAt <= s.firstAt then return end print(string.format("[Armada] gun macro: %d shots in %.2fs = %.1f shots/s", s.shots, s.lastAt - s.firstAt, (s.shots - 1) / (s.lastAt - s.firstAt))) end local function stopMacro() if M.running then if M.seq then report(M.queue and M.queue[M.index]) else reportRun() end M.running, M.queue, M.stats = false, nil, nil disconnectAll() if type(mouse1release) == "function" then pcall(mouse1release) end end if M.dirty then M.dirty = false task.defer(function() if menuOpen() and rebuildAll then rebuildAll() end end) end end local function downStop() M.latched = M.held stopMacro() end local function hookGun(g) M.conns[#M.conns + 1] = g.tool:GetAttributeChangedSignal("Cooldown"):Connect(function() if not g.tool:GetAttribute("Cooldown") and M.running and M.queue and M.queue[M.index] == g then process() end end) end local function startMacro() if M.running or not M.enabled or M.latched or SCRIPT_KILLED or not MENU_UNLOCKED then return end if #M.guns == 0 then UI.notify("Gun Macro", "Add at least one gun on the Guns page first.") return end if UI.mouseOverMenu() then return end if M.knockCheck and isLocalPlayerKnockedOrDead() then M.latched = M.held return end local seq = (M.method == METHODS[3]) local skipEmpty = (M.method == METHODS[2]) local queue, sum = {}, 0 for _, name in ipairs(M.guns) do local tool = findGun(name) local ammo = gunAmmo(tool) if ammo and (ammo.Value > 0 or not (seq or skipEmpty)) then local g = { name = name, tool = tool, ammo = ammo, last = ammo.Value, shotgun = isShotgun(name) } if seq then g.inflight, g.nextClick, g.ackWait = 0, 0, ackTimeout() end queue[#queue + 1] = g sum = sum + ammo.Value end end if #queue == 0 then UI.notify("Gun Macro", "None of the selected guns are in your inventory" .. ((seq or skipEmpty) and " with ammo." or ".")) return end local now = os.clock() M.seq, M.skipEmpty = seq, skipEmpty M.queue, M.running, M.startedAt = queue, true, now if seq then M.index = 1 for _, g in ipairs(queue) do hookGun(g) end else M.index = 0 M.nextStep, M.lastSent, M.prevShotgunAt = now, nil, -10 M.stats = { shots = 0, firstAt = now, lastAt = now, sum = sum, changedAt = now } end end local function advance() if M.queue then report(M.queue[M.index]) end M.index = M.index + 1 if not M.queue or M.index > #M.queue then stopMacro() end end local function stepSequential() if not M.enabled then stopMacro() return false end local char = LocalPlayer.Character local hum = char and char:FindFirstChildOfClass("Humanoid") if not hum or hum.Health <= 0 then downStop() return false end if M.knockCheck and isLocalPlayerKnockedOrDead() then downStop() return false end if UI.mouseOverMenu() then stopMacro() return false end local now = os.clock() if now - M.startedAt > MAX_RUN then stopMacro() return false end local g = M.queue[M.index] local tool, ammo = g.tool, g.ammo if not tool.Parent or not ammo.Parent then advance() return true end local ammoNow = ammo.Value if ammoNow ~= g.last then if ammoNow < g.last then local drops = g.last - ammoNow g.inflight = math.max(0, g.inflight - drops) g.shots = (g.shots or 0) + drops g.firstDropAt = g.firstDropAt or now g.lastDropAt = now end g.last = ammoNow g.changedAt = now end if ammoNow <= 0 then advance() return true end if tool.Parent ~= char then g.equipSince = g.equipSince or now if now - g.equipSince > EQUIP_TIMEOUT then advance() return true end if now >= (g.nextEquip or 0) then g.nextEquip = now + EQUIP_RETRY pcall(hum.EquipTool, hum, tool) end if tool.Parent ~= char then return false end end if not g.ready then g.ready = true g.changedAt = now g.nextClick = now + M.delayMs / 1000 end if now - g.changedAt > STALL then advance() return true end if g.inflight > 0 and now - (g.lastSendAt or now) > g.ackWait then g.inflight = 0 end local maxInflight = MAX_INFLIGHT if g.inflight >= maxInflight then return false end if now < g.nextClick then return false end if not canShoot(char, tool) then return false end local refusedFirst = char:GetAttribute("ShotgunDebounce") and char:GetAttribute("LastGunShot") ~= tool.Name sendClick() g.lastSendAt = now g.ackWait = ackTimeout() if not refusedFirst then g.inflight = g.inflight + 1 end local delay = M.delayMs / 1000 local nxt = g.nextClick + delay if now - nxt > delay then nxt = now end g.nextClick = nxt return false end local function stepCycle() if not M.enabled then stopMacro() return end local char = LocalPlayer.Character local hum = char and char:FindFirstChildOfClass("Humanoid") if not hum or hum.Health <= 0 then downStop() return end if M.knockCheck and isLocalPlayerKnockedOrDead() then downStop() return end if UI.mouseOverMenu() then stopMacro() return end local now = os.clock() if now < M.nextStep then return end local queue, s = M.queue, M.stats local n, sum, shots = #queue, 0, 0 for _, g in ipairs(queue) do local v = (g.ammo.Parent and g.tool.Parent) and g.ammo.Value or 0 if v < g.last then shots = shots + (g.last - v) end g.last = v sum = sum + v end if shots > 0 then s.shots, s.lastAt = s.shots + shots, now end if sum ~= s.sum then s.sum, s.changedAt = sum, now end if M.skipEmpty and sum <= 0 then stopMacro() return end if now - s.changedAt > STALL_ALL then stopMacro() return end local idx, g = M.index, nil for _ = 1, n do idx = idx % n + 1 local c = queue[idx] if (not M.skipEmpty or c.last > 0) and not (c.tool.Parent and c.tool:GetAttribute("Cooldown")) then g = c break end end if not g then return end local tool = g.tool M.index = idx if not tool.Parent then return end if tool.Parent ~= char then pcall(hum.EquipTool, hum, tool) end if tool.Parent ~= char then return end local debounce = char:GetAttribute("ShotgunDebounce") or (now - M.prevShotgunAt < 0.65) local refused = debounce and M.lastSent ~= tool.Name sendClick() if refused then sendClick() end M.lastSent = tool.Name if g.shotgun then M.prevShotgunAt = now end M.nextStep = now + M.delayMs / 1000 end local processing = false process = function() if processing then return end processing = true local ok, err = pcall(function() if not M.running then return end if M.seq then for _ = 1, 8 do if not M.running then break end if not stepSequential() then break end end else stepCycle() end end) processing = false if not ok then warn("[Armada] gun macro stopped: " .. tostring(err)) stopMacro() end end local stepConn, beatConn local function onFrame(fromRender) if SCRIPT_KILLED then stopMacro() if stepConn then stepConn:Disconnect() end if beatConn then beatConn:Disconnect() end return end if M.running then if fromRender and not M.seq and M.queue and #M.queue > 1 then return end process() end end stepConn = RunService.RenderStepped:Connect(function() onFrame(true) end) beatConn = RunService.Heartbeat:Connect(function() onFrame(false) end) W.section(KEYS, "Macro") local keyBtn = W.keybind(KEYS, "Macro Key") local function refreshKey() keyBtn.Text = M.listening and "PRESS A KEY..." or (M.key and M.key.Name or "NONE") end keyBtn.MouseButton1Click:Connect(function() if dead() then return end M.listening = true refreshKey() end) keyBtn.MouseButton2Click:Connect(function() if dead() or UI.rmbGuard then return end M.key, M.listening = nil, false M.held, M.latched = false, false refreshKey() end) W.register(refreshKey) refreshKey() W.segmented(KEYS, "Mode", { "Hold", "Toggle" }, function() return M.mode end, function(mode) M.mode = mode M.held, M.latched = false, false stopMacro() end) UserInputService.InputBegan:Connect(function(input, gameProcessed) if dead() then return end if M.listening then if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then if input.KeyCode == Enum.KeyCode.Escape then M.key = nil else M.key = input.KeyCode end M.listening = false M.held, M.latched = false, false refreshKey() end return end if gameProcessed or UserInputService:GetFocusedTextBox() then return end if M.key and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == M.key then M.held = true if M.mode == "Toggle" and M.running then stopMacro() else startMacro() if M.running then process() end end end end) UserInputService.InputEnded:Connect(function(input) if SCRIPT_KILLED then return end if M.key and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == M.key then M.held, M.latched = false, false if M.mode == "Hold" and M.running then stopMacro() end end end) UserInputService.WindowFocusReleased:Connect(function() M.held, M.latched = false, false if M.mode == "Hold" and M.running then stopMacro() end end) W.section(SET, "Macro") W.dropdown(SET, "Method", METHODS, function() return M.method end, function(v) M.method = v stopMacro() end) W.numberInput(SET, "Delay (ms)", 0, 1000, 1, function() return M.delayMs end, function(v) M.delayMs = v end) W.toggle(SET, "Knock Check", function() return M.knockCheck end, function(v) M.knockCheck = v end) local function ammoText(tool) local ammo = gunAmmo(tool) if not ammo then return "not in inventory" end local max = tool:FindFirstChild("MaxAmmo") return tostring(ammo.Value) .. (max and ("/" .. tostring(max.Value)) or "") .. " ammo" end local function listCard(page, height) local r = W.row(page, height) local card = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.card, BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = 2, }, r) corner(card, 12) stroke(card, T.stroke, 1, 0) local list = new("ScrollingFrame", { Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -12), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.accent, ScrollBarImageTransparency = 0.35, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 3, }, card) new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list) return list end local function ammoShort(tool) local ammo = gunAmmo(tool) if not ammo then return "n/a" end local max = tool:FindFirstChild("MaxAmmo") return tostring(ammo.Value) .. (max and ("/" .. tostring(max.Value)) or "") end local LIST_TOP = 30 local function cardIn(parent, title, hint) local card = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.card, Backg