.Y + ps.Y end return false end UI.tb.hookEnd = 0 UI.tb.hookGap = 1 / 120 UI.tb.lastClickAt = 0 UI.tb.shotChar = nil UI.tb.ignore = {} UI.tb.cast = function(origin, direction, skip) local params = UI.tb.params if not params then params = RaycastParams.new() params.FilterType = Enum.RaycastFilterType.Exclude params.IgnoreWater = true UI.tb.params = params end local ignore = UI.tb.ignore local n = 0 local mine = LocalPlayer.Character if mine then n = n + 1 ignore[n] = mine end local folder = UI.tb.ignoredFolder if not folder or folder.Parent ~= workspace then folder = workspace:FindFirstChild("Ignored") UI.tb.ignoredFolder = folder end if folder then n = n + 1 ignore[n] = folder end if skip then n = n + 1 ignore[n] = skip end for i = #ignore, n + 1, -1 do ignore[i] = nil end for _ = 1, 8 do params.FilterDescendantsInstances = ignore local result = workspace:Raycast(origin, direction, params) if not result then return nil end local hit = result.Instance local model = hit:FindFirstAncestorOfClass("Model") local isPlayerPart = model ~= nil and (model:FindFirstChildOfClass("Humanoid") ~= nil or Players:GetPlayerFromCharacter(model) ~= nil) if isPlayerPart then return result end if hit.Transparency >= 0.9 or not hit.CanCollide or isLikelyTracerObject(hit) then n = n + 1 ignore[n] = hit else return result end end return nil end UI.tb.centerPart = function() local camera = workspace.CurrentCamera if not camera then return nil end local point = AIM_BIND.aimPoint(camera) local ray = camera:ViewportPointToRay(point.X, point.Y) local result = UI.tb.cast(ray.Origin, ray.Direction * 2000) return result and result.Instance or nil end UI.tb.step = function() local T = UI.tb if not TRIGGERBOT_ENABLED then T.state = "OFF (master toggle is off)" return false end if UI.mouseOverMenu() then T.pendingChar = nil T.state = "PAUSED (cursor over menu)" return false end if not triggerbotCanFire() then if isKatanaEquipped() then T.state = "BLOCKED (melee / katana / sword equipped)" else T.state = "WAITING FOR TRIGGER KEY (" .. tostring(TB_MODE) .. ")" end return false end local target, _, targetCharacter = getTriggerbotTarget() if not target then if T.pendingChar then local lostNow = os.clock() T.lostAt = T.lostAt or lostNow if lostNow - T.lostAt > 0.06 then T.pendingChar = nil T.lostAt = nil T.shotChar = nil end end local localChar = LocalPlayer.Character if not localChar or not localChar:FindFirstChildWhichIsA("Tool") then T.state = "ARMED - no gun/tool equipped (distance check needs one)" elseif TB_LIST_MODE == "Blacklist" then T.state = "ARMED - Blacklist mode only shoots SELECTED players" else T.state = "ARMED - no valid target" end return false end local clock = os.clock() T.lostAt = nil if T.pendingChar ~= targetCharacter then T.pendingChar = targetCharacter T.pendingSince = clock T.shotChar = nil end local delaySeconds = T.delayMs() / 1000 local fireAt = T.pendingSince + delaySeconds if delaySeconds > 0 and clock < fireAt then local window = T.hookGap * 1.2 + 0.0008 if window > 0.03 then window = 0.03 end if fireAt - clock > window then T.state = "TARGET FOUND - waiting out delay" return false end T.state = "TARGET FOUND - firing on the dot" while os.clock() < fireAt do end end clock = os.clock() local firstShot = (T.shotChar ~= targetCharacter) if not firstShot and clock - T.lastClickAt < UI._frameGap * 0.85 then T.state = "FIRING" return false end if firstShot then local env = type(getgenv) == "function" and getgenv() or _G if env.ARMADA_TB_DEBUG then print(string.format("[Armada] triggerbot: delay set %.1f ms, click sent %.2f ms after acquire (look gap %.1f ms)", delaySeconds * 1000, (clock - T.pendingSince) * 1000, T.hookGap * 1000)) end end T.shotChar = targetCharacter T.lastClickAt = clock AIM_BIND.lastOwnClick = clock T.state = "FIRING" if type(mouse1press) == "function" and type(mouse1release) == "function" then local pressOK = pcall(mouse1press) local releaseOK = pcall(mouse1release) if not (pressOK and releaseOK) then UI.tb.state = "FIRIN