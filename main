    clockLabel.AnchorPoint = Vector2.new(1, 1)
    clockLabel.Position = UDim2.new(1, -24, 1, -20)

    local stages = {
        { 0.00, "Initializing services" },
        { 0.28, "Loading modules" },
        { 0.55, "Reading configuration" },
        { 0.80, "Preparing interface" },
        { 0.97, "Ready" },
    }

    local duration = 3.6
    local startTime = os.clock()
    local lastStage = 0
    local lastPercent = -1

    while gui.Parent and not SCRIPT_KILLED do
        local elapsed = os.clock() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)
        local eased = alpha * alpha * (3 - 2 * alpha)

        barFill.Size = UDim2.new(eased, 0, 1, 0)
        barHead.Position = UDim2.new(eased, 0, 0.5, 0)

        local percent = math.floor(eased * 100 + 0.5)
        if percent ~= lastPercent then
            lastPercent = percent
            percentLabel.Text = tostring(percent) .. "%"
        end

        local stageIndex = 1
        for index, entry in ipairs(stages) do
            if eased >= entry[1] then
                stageIndex = index
            end
        end
        if stageIndex ~= lastStage then
            lastStage = stageIndex
            stageLabel.Text = stages[stageIndex][2]
        end

        ringOuterGradient.Rotation = (elapsed * 140) % 360
        ringInnerGradient.Rotation = (-elapsed * 90) % 360
        for index, orbitDot in ipairs(orbits) do
            local angle = elapsed * (1.4 + index * 0.35) + index * 2.1
            orbitDot.Position = UDim2.fromOffset(
                140 + math.cos(angle) * 122 - 4,
                140 + math.sin(angle) * 122 - 4
            )
        end

        local wave = math.sin(elapsed * 2.2)
        pulse.BackgroundTransparency = 0.9 + 0.05 * wave
        local pulseSize = 300 + 14 * wave
        pulse.Size = UDim2.fromOffset(pulseSize, pulseSize)
        glowA.BackgroundTransparency = 0.94 + 0.02 * math.sin(elapsed * 0.9)
        glowB.BackgroundTransparency = 0.975 + 0.01 * math.cos(elapsed * 0.8)

        for index, letter in ipairs(letters) do
            local reveal = math.clamp((elapsed - 0.35 - index * 0.11) / 0.35, 0, 1)
            letter.TextTransparency = 1 - reveal
            letter.Position = UDim2.fromOffset(0, (1 - reveal) * 16)
        end
        tagline.TextTransparency = 1 - math.clamp((elapsed - 1.2) / 0.5, 0, 1)

        scan.Position = UDim2.new(0, 0, 0, 0)
        local scanY = ((elapsed * 0.32) % 1.3) - 0.15
        scan.Position = UDim2.fromScale(0, scanY)

        for _, particle in ipairs(particles) do
            local y = 1 - ((elapsed * particle.speed + particle.offset) % 1)
            particle.dot.Position = UDim2.fromScale(
                particle.x + math.sin(elapsed + particle.phase) * particle.sway,
                y
            )
            local edge = math.abs(y - 0.5) * 2
            particle.dot.BackgroundTransparency = 0.3 + 0.7 * edge * edge
        end

        if elapsed >= duration then
            break
        end

        task.wait()
    end

    if gui.Parent then
        percentLabel.Text = "100%"
        stageLabel.Text = "Ready"
        barFill.Size = UDim2.new(1, 0, 1, 0)
        barHead.Position = UDim2.new(1, 0, 0.5, 0)
        task.wait(0.25)

        if useGroup then
            UI.tween(root, 0.45, { GroupTransparency = 1 })
        else
            UI.tween(root, 0.45, { BackgroundTransparency = 1 })
        end
        task.wait(0.5)
        gui:Destroy()
    end
end

showLoadingScreen()

if SCRIPT_KILLED then
    return
end

local WHITELISTED_USER_IDS = loadWhitelistedUserIds()

if not WHITELISTED_USER_IDS then
    LocalPlayer:Kick("Unable to verify Armada whitelist.")
    return
end

if not WHITELISTED_USER_IDS[LocalPlayer.UserId] then
    LocalPlayer:Kick("You're not whitelisted to use Armada, loser.")
    return
end

