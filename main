local function matchesKeyboardKey(input, keyCode)
    return keyCode ~= Enum.KeyCode.Unknown
        and input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode == keyCode
end

local killConnection
killConnection = UserInputService.InputBegan:Connect(function(input)

    if UI_BIND_LISTENING or os.clock() < UI_KEY_ASSIGN_IGNORE_UNTIL then
        return
    end

    if not matchesKeyboardKey(input, UI_KILL_KEYCODE) then
        return
    end

    SCRIPT_KILLED = true
    TRIGGER_HELD = false
    TRIGGER_TOGGLED = false
    HOST_TRIGGER_ARMED = false

    if killConnection then
        killConnection:Disconnect()
        killConnection = nil
    end

    pcall(function()
        RunService:UnbindFromRenderStep("Triggerbot_RenderStep")
    end)

    for _, name in ipairs({"ModernKeyGate", "MinimalWhitelist", "ArmadaLoading"}) do
        local gui = CoreGui:FindFirstChild(name)
        if gui then
            gui:Destroy()
        end
    end
end)

local LOADING_IMAGE_FILE = "armada_mascot_v2.png"
local LOADING_IMAGE_B64 = [[]]

local function decodeLoadingImage(data)
    local decoded

    pcall(function()
        if crypt and type(crypt.base64decode) == "function" then
            decoded = crypt.base64decode(data)
        elseif crypt and crypt.base64 and type(crypt.base64.decode) == "function" then
            decoded = crypt.base64.decode(data)
        elseif syn and syn.crypt and type(syn.crypt.base64decode) == "function" then
            decoded = syn.crypt.base64decode(data)
        elseif syn and syn.crypt and type(syn.crypt.base64) == "function" then
            decoded = syn.crypt.base64(data)
        elseif base64 and type(base64.decode) == "function" then
            decoded = base64.decode(data)
        elseif type(base64decode) == "function" then
            decoded = base64decode(data)
        elseif type(base64_decode) == "function" then
            decoded = base64_decode(data)
        end
    end)

    return decoded
end

local function getLoadingImage()
    if type(getcustomasset) ~= "function" then
        return nil
    end

    local ok, asset = pcall(function()
        return getcustomasset(LOADING_IMAGE_FILE)
    end)

    if ok and asset then
        return asset
    end

    if type(writefile) == "function" then
        local decoded = decodeLoadingImage(LOADING_IMAGE_B64)

        if decoded then
            local wrote = pcall(function()
                writefile(LOADING_IMAGE_FILE, decoded)
            end)

            if wrote then
                local loaded, newAsset = pcall(function()
                    return getcustomasset(LOADING_IMAGE_FILE)
                end)

                if loaded and newAsset then
                    return newAsset
                end
            end
        end
    end

    return nil
end

local UI = {}

UI.Theme = {

    bg      = Color3.fromRGB(0, 0, 0),
    panel   = Color3.fromRGB(0, 0, 0),
    card    = Color3.fromRGB(16, 16, 20),
    card2   = Color3.fromRGB(25, 25, 31),
    field   = Color3.fromRGB(8, 8, 11),
    stroke  = Color3.fromRGB(38, 38, 46),
    text    = Color3.fromRGB(246, 246, 248),
    sub     = Color3.fromRGB(152, 154, 164),
    dim     = Color3.fromRGB(98, 100, 110),
    accent  = Color3.fromRGB(34, 211, 238),
    accent2 = Color3.fromRGB(255, 255, 255),
    soft    = Color3.fromRGB(8, 42, 50),
    good    = Color3.fromRGB(34, 211, 238),
    bad     = Color3.fromRGB(248, 113, 113),
}

UI.TextService = game:GetService("TextService")

function UI.new(className, props, parent)
    local inst = Instance.new(className)
    for key, value in pairs(props) do
        inst[key] = value
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

function UI.corner(inst, radius)
    return UI.new("UICorner", {
        CornerRadius = UDim.new(0, radius),
    }, inst)
end

function UI.stroke(inst, color, thickness, transparency)
    return UI.new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

function UI.tween(inst, seconds, props)
    local tw = TweenService:Create(
        inst,
        TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        props
    )
    tw:Play()
    return tw
end

function UI.label(parent, text, x, y, w, h, size, color, font, align)
    return UI.new("TextLabel", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        Text = text,
        TextSize = size or 12,
        TextColor3 = color or UI.Theme.text,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Active = false,
    }, parent)
end

function UI.textWidth(text, size, font)
    local ok, bounds = pcall(function()
        return UI.TextService:GetTextSize(text, size, font, Vector2.new(1000, 100))
    end)
    if ok and bounds then
        return bounds.X
    end
    return #text * (size * 0.6)
end

function UI.button(parent, x, y, w, h, text, kind)
    local T = UI.Theme
    local base, hover, textColor

    if kind == "primary" then
        base = T.accent
        hover = Color3.fromRGB(34, 211, 238)
        textColor = Color3.fromRGB(0, 0, 0)
    elseif kind == "danger" then
        base = T.card2
        hover = T.accent
        textColor = T.text
    else
        base = T.card2
        hover = Color3.fromRGB(255, 255, 255)
        textColor = T.text
    end

    local button = UI.new("TextButton", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = base,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = textColor,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        AutoButtonColor = false,
    }, parent)

    button:SetAttribute("BaseTextColor", textColor)

    UI.corner(button, 8)
    if kind ~= "primary" then
        UI.stroke(button, T.stroke, 1, 0)
    end

    button.MouseEnter:Connect(function()
        if not button:GetAttribute("Sel") then
            UI.tween(button, 0.12, {
                BackgroundColor3 = hover,
                TextColor3 = hover == Color3.fromRGB(255, 255, 255)
                    and Color3.fromRGB(0, 0, 0)
                    or textColor
            })
        end
    end)

    button.MouseLeave:Connect(function()
        if not button:GetAttribute("Sel") then
            UI.tween(button, 0.12, {
                BackgroundColor3 = base,
                TextColor3 = textColor
            })
        end
    end)

    return button
end

function UI.input(parent, x, y, w, h, text, placeholder)
    local T = UI.Theme
    local box = UI.new("TextBox", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = T.field,
        BorderSizePixel = 0,
        Text = text or "",
        PlaceholderText = placeholder or "",
        PlaceholderColor3 = T.dim,
        TextColor3 = T.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false,
    }, parent)

    UI.corner(box, 8)
    local outline = UI.stroke(box, T.stroke, 1, 0)

    box.Focused:Connect(function()
        UI.tween(outline, 0.15, { Color = T.accent })
    end)

    box.FocusLost:Connect(function()
        UI.tween(outline, 0.15, { Color = T.stroke })
    end)

    return box
end

function UI.card(parent, name, x, y, w, h, title, subtitle)
    local T = UI.Theme
    local card = UI.new("Frame", {
        Name = name,
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = T.card,
        BorderSizePixel = 0,
        Active = false,
    }, parent)

    UI.corner(card, 10)
    UI.stroke(card, T.stroke, 1, 0)

    local marker = UI.new("Frame", {
        Position = UDim2.fromOffset(14, 14),
        Size = UDim2.fromOffset(3, subtitle and 26 or 14),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, card)
    UI.corner(marker, 2)
    UI.new("UIGradient", {
        Color = ColorSequence.new(T.accent, T.accent2),
        Rotation = 90,
    }, marker)

    UI.label(card, title, 26, 12, w - 40, 16, 12, T.text, Enum.Font.GothamBold)
    if subtitle then
        UI.label(card, subtitle, 26, 28, w - 40, 14, 10, T.dim, Enum.Font.Gotham)
    end

    return card
end

function UI.getPortrait()
    if UI._portraitTried == nil then
        UI._portraitTried = true
        UI._portrait = getLoadingImage()
    end
    return UI._portrait
end

