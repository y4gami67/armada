                for _, child in ipairs(modeCard:GetChildren()) do
                    if child:IsA("TextButton") and child ~= button then
                        child:SetAttribute("Sel", false)
                        UI.tween(child, 0.15, { BackgroundColor3 = T.card2 })
                    end
                end
                UI.tween(button, 0.15, { BackgroundColor3 = T.soft })
                UI.tween(stroke, 0.15, { Color = T.accent })
                local selectedTitle = button:FindFirstChild("Title")
                if selectedTitle then selectedTitle.TextColor3 = T.text end
                for _, child in ipairs(modeCard:GetChildren()) do
                    if child:IsA("TextButton") and child ~= button then
                        local childStroke = child:FindFirstChildOfClass("UIStroke")
                        if childStroke then
                            UI.tween(childStroke, 0.15, { Color = T.stroke })
                        end
                        local childTitle = child:FindFirstChild("Title")
                        if childTitle then childTitle.TextColor3 = T.sub end
                    end
                end
            end)

            button:SetAttribute("Sel", mode == TB_MODE)
            if mode == TB_MODE then
                button.BackgroundColor3 = T.soft
                stroke.Color = T.accent
            end
        end

        TB_PAGE_REFRESH = function()
            if keyButton and keyButton.Parent then
                keyButton.Text = TB_BIND_LISTENING and "PRESS A KEY..." or TB_KEY_LABEL
            end
        end
