local function updateTriggerModeUI()
    local T = UI.Theme
    for mode, button in pairs(triggerModeButtons) do
        local selected = (mode == TRIGGER_MODE)
        button:SetAttribute("Sel", selected)
        UI.tween(button, 0.15, { BackgroundColor3 = selected and T.soft or T.card2 })

        local outline = triggerModeStrokes[mode]
        if outline then
            UI.tween(outline, 0.15, { Color = selected and T.accent or T.stroke })
        end

        local title = button:FindFirstChild("Title")
        if title then
            title.TextColor3 = selected and T.text or T.sub
        end
    end
end

