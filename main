.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.fromOffset(2, 2), BackgroundColor3 = T.accent, BorderSizePixel = 0, ZIndex = 10, Active = false, }, ring) corner(dot, 1) new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 5), Size = UDim2.fromOffset(2, 5), BackgroundColor3 = T.accent, BorderSizePixel = 0, ZIndex = 10, Active = false, }, ring) btn.MouseEnter:Connect(function() rs.Transparency = 0 end) btn.MouseLeave:Connect(function() rs.Transparency = 0.2 end) btn.MouseButton1Click:Connect(function() if dead() then return end UI.notify(title or text, state.desc .. state.suffix) end) end build() page.lastInfo = function(d) if not state.desc then state.desc = d build() end end end local function mkField(parent, w, h) local f = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(w, h), BackgroundColor3 = T.field, BorderSizePixel = 0, ZIndex = 3, Active = false, }, parent) corner(f, 7) local st = stroke(f, T.stroke, 1, 0.35) return f, st end function W.card(r, extra) extra = extra or 8 r.Size = UDim2.new(1, 0, 0, r.Size.Y.Offset + extra) new("UIPadding", { PaddingTop = UDim.new(0, math.floor(extra / 2)), PaddingBottom = UDim.new(0, math.floor(extra / 2)), }, r) return r end function W.section(page, title) W.makePanel(page) page.lastInfo = nil local r = row(page, 32) local l = UI.label(r, title, 0, 0, 400, 26, 12, T.sub, GB) l.ZIndex = 3 new("Frame", { Position = UDim2.fromOffset(0, 29), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 3, Active = false, }, r) return r end function W.caption(page, text, h) if page.lastInfo then page.lastInfo(text) end return nil end function W.toggle(page, text, get, set, withSwatch) local r = row(page, 24) W.card(r, 8) local box = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = UI.btn.fill, BorderSizePixel = 0, ZIndex = 3, Active = false, }, r) corner(box, 6) local bst = stroke(box, T.stroke, 1, 0.2) local fill = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = UI.btn.text, BorderSizePixel = 0, Visible = false, ZIndex = 4, Active = false, }, box) corner(fill, 3) local lbl = UI.label(r, text, 30, 0, 300, 24, 12, T.sub, GB) lbl.ZIndex = 3 lbl.Size = UDim2.new(1, -62, 1, 0) lbl.TextTruncate = Enum.TextTruncate.AtEnd local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, }, r) W.attachInfo(page, r, text, 30, 12, 130) local lastOn = nil local function paint() local on = get() and true or false if on == lastOn then return end lastOn = on fill.Visible = on bst.Color = on and T.accent or T.stroke bst.Transparency = on and 0 or 0.2 lbl.TextColor3 = on and T.text or T.sub end hit.MouseButton1Click:Connect(function() if dead() then return end set(not get()) paint() if UI.refreshPreview then UI.refreshPreview() end end) reg(paint) paint() return r end function W.slider(page, text, min, max, step, get, set, fmt) local r = row(page, 36) W.card(r, 8) local lbl = UI.label(r, text, 0, 0, 200, 16, 12, T.sub, GB) lbl.ZIndex = 3 lbl.Size = UDim2.new(1, -60, 0, 16) lbl.TextTruncate = Enum.TextTruncate.AtEnd W.attachInfo(page, r, text, 0, 8, 120) local val = UI.label(r, "", 0, 0, 80, 16, 12, T.sub, GB, RIGHT) val.AnchorPoint = Vector2.new(1, 0) val.Position = UDim2.new(1, 0, 0, 0) val.ZIndex = 3 local track = new("Frame", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = T.field, BorderSizePixel = 0, ZIndex = 3, }, r) corner(track, 2) local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.accent, BorderSizePixel = 0, ZIndex = 4, }, track) corner(fill, 2) local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = T.text, BorderSizePixel = 0, ZIndex = 5, }, track) corner(knob, 6) local hit = new("TextButton", { Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6, }, r) local lastV = nil local function paint() local v = get() if v == lastV then return end lastV = v local a = math.clamp((v - min) / (max - min), 0, 1) fill.Size = UDim2.fromScale(a, 1) knob.Position = UDim2.new(a, 0, 0.5, 0) val.Text = fmt and fmt(v) or tostring(v) end local function fromPointer(pos) if dead() then return end local a = math.clamp((pos.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1) local v = min + a * (max - min) v = math.floor(v / step + 0.5) * step v = math.clamp(v, min, max) set(v) paint() end hit.InputBegan:Connect(function(input) if isPress(input) and not dead() then beginDrag(fromPointer, input) end end) reg(paint) paint() return r end function W.numberInput(page, text, min, max, step, get, set) local r = row(page, 24) W.card(r, 6) local l = UI.label(r, text, 0, 0, 240, 24, 12, T.sub, GB) l.ZIndex = 3 l.Size = UDim2.new(1, -64, 1, 0) l.TextTruncate = Enum.TextTruncate.AtEnd W.attachInfo(page, r, text, 0, 12, 112) local field, fst = mkField(r, 56, 24) local box = new("TextBox", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ClearTextOnFocus = false, TextColor3 = T.text, Font = GB, TextSize = 12, TextXAlignment = CENTER, BorderSizePixel = 0, ZIndex = 4, }, field) box.Focused:Connect(function() fst.Color = T.accent end) local function paint() if UserInputService:GetFocusedTextBox() ~= box then box.Text = tostring(get()) end end box.FocusLost:Connect(function() fst.Color = T.stroke local v = tonumber(box.Text) if v and not dead() then v = math.floor(math.clamp(v, min, max) / step + 0.5) * step set(math.clamp(v, min, max)) end paint() if UI.refreshPreview then UI.refreshPreview() end end) reg(paint) paint() return r end function W.rangeBar(page, title, getLo, getHi, setLo, setHi, max, unit) local r = row(page, 88) W.card(r, 8) local heading = UI.label(r, title, 0, 0, 260, 16, 12, T.sub, GB) W.attachInfo(page, r, title, 0, 8, 200, nil, "Delay Range") heading.ZIndex = 3 local readout = UI.label(r, "", 0, 0, 220, 16, 11, T.accent, GB, RIGHT) readout.AnchorPoint = Vector2.new(1, 0) readout.Position = UDim2.new(1, 0, 0, 0) readout.ZIndex = 3 local track = new("Frame", { Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.field, BorderSizePixel = 0, ZIndex = 3, }, r) corner(track, 3) local fill = new("Frame", { Size = UDim2.fromScale(0.01, 1), BackgroundColor3 = T.accent, BorderSizePixel = 0, ZIndex = 4, }, track) for i = 0, 4 do local f = i / 4 new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(f, 0, 1, 4), Size = UDim2.fromOffset(1, 4), BackgroundColor3 = T.dim, BorderSizePixel = 0, ZIndex = 3, }, track) local txt = tostring(math.floor(max * f + 0.5)) if i == 4 then txt = txt .. " " .. unit end local tl = UI.label(r, txt, 0, 0, 70, 12, 9, T.dim, GR, CENTER) tl.AnchorPoint = Vector2.new(0.5, 0) tl.Position = UDim2.new(f, f == 0 and 8 or (f == 1 and -8 or 0), 0, 46) tl.ZIndex = 3 end local function makeKnob() local k = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(13, 13), BackgroundColor3 = T.text, BorderSizePixel = 0, ZIndex = 6, }, track) corner(k, 7) return k end local knobLo, knobHi = makeKnob(), makeKnob() local summary = UI.label(r, "", 0, 66, 400, 16, 10, T.dim, GM) summary.ZIndex = 3 local lastLo, lastHi = nil, nil local function paint() local lo, hi = getLo(), getHi() if lo == lastLo and hi == lastHi then return end lastLo, lastHi = lo, hi if lo > hi then lo, hi = hi, lo end local a0, b0 = math.clamp(lo / max, 0, 1), math.clamp(hi / max, 0, 1) fill.Position = UDim2.new(a0, 0, 0, 0) fill.Size = UDim2.new(math.max(b0 - a0, 0.008), 0, 1, 0) knobLo.Position = UDim2.new(a0, 0, 0.5, 0) knobHi.Position = UDim2.new(b0, 0, 0.5, 0) knobHi.Visible = hi ~= lo if hi == lo then readout.Text = string.format("%d %s", lo, unit) summary.Text = lo == 0 and "No delay: shoots instantly" or string.format("Fixed delay of %d %s every shot", lo, unit) else readout.Text = string.format("%d - %d %s", lo, hi, unit) summary.Text = string.format("Random delay between %d and %d %s (avg about %d)", lo, hi, unit, math.floor((lo + hi) / 2 + 0.5)) end end local function fromPointer(pos, which) if dead() then return end local a0 = math.clamp((pos.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1) local v = math.floor(a0 * max + 0.5) if which == "lo" then setLo(math.min(v, max)) else setHi(math.min(v, max)) end paint() if UI.syncWidgets then UI.syncWidgets() end end local hit = new("TextButton", { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 7, }, r) hit.InputBegan:Connect(function(input) if isPress(input) and not dead() then local px = pointerOf(input).X local dLo = math.abs(px - (knobLo.AbsolutePosition.X + 4)) local dHi = math.abs(px - (knobHi.AbsolutePosition.X + 4)) local which = (dLo <= dHi) and "lo" or "hi" if getLo() == getHi() then which = (px < knobLo.AbsolutePosition.X + 4) and "lo" or "hi" end beginDrag(function(pos) fromPointer(pos, which) end, input) end end) reg(paint) paint() return r end function W.segmented(page, label, options, get, set) local r = row(page, label and 50 or 26) W.card(r, 6) if label then local l = UI.label(r, label, 0, 0, 240, 16, 12, T.sub, GB) l.ZIndex = 3 W.attachInfo(page, r, label, 0, 8, 200) end local y0 = label and 20 or 0 local x = 0 local btns = {} for _, opt in ipairs(options) do local id, txt = opt, opt if type(opt) == "table" then id, txt = opt[1], opt[2] end local w = UI.textWidth(txt, 11, GM) + 24 local b = new("TextButton", { Position = UDim2.fromOffset(x, y0), Size = UDim2.fromOffset(w, 24), BackgroundColor3 = UI.btn.fill, Text = txt, TextColor3 = UI.btn.sub, TextSize = 11, Font = GB, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 4, }, r) corner(b, 7) local st = stroke(b, T.stroke, 1, 0.35) btns[#btns + 1] = { b = b, id = id, st = st } b.MouseButton1Click:Connect(function() if dead() then return end set(id) for _, e in ipairs(btns) do local sel = (get() == e.id) e.b.BackgroundColor3 = sel and UI.btn.sel or UI.btn.fill e.b.TextColor3 = sel and UI.btn.text or UI.btn.sub e.st.Color = sel and T.accent or T.stroke end if UI.refreshPreview then UI.refreshPreview() end end) x = x + w + 4 end local lastSel = {} local function paint() local current = get() if current == lastSel[1] and lastSel[2] then return end lastSel[1], lastSel[2] = current, true for _, e in ipairs(btns) do local sel = (get() == e.id) e.b.BackgroundColor3 = sel and UI.btn.sel or UI.btn.fill e.b.TextColor3 = sel and UI.btn.text or UI.btn.sub e.st.Color = sel and T.accent or T.stroke end end reg(paint) paint() return r end local function chevron(parent) local c = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5, Active = false, }, parent) for _, s in ipairs({ { -2.2, 45 }, { 2.2, -45 } }) do new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, s[1], 0.5, 0.5), Size = UDim2.fromOffset(6, 1.5), Rotation = s[2], BackgroundColor3 = UI.btn.sub, BorderSizePixel = 0, ZIndex = 5, }, c) end end local function pill(parent, w, h) local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(w, h), BackgroundColor3 = UI.btn.fill, Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 4, }, parent) corner(b, h / 2) local st = stroke(b, T.stroke, 1, 0.3) return b, st end function W.dropdown(page, text, options, get, set) local r = row(page, 54) W.card(r, 6) local l = UI.label(r, text, 0, 0, 240, 16, 12, T.sub, GB) l.ZIndex = 3 l.TextTruncate = Enum.TextTruncate.AtEnd W.attachInfo(page, r, text, 0, 8, 200) local btn = new("TextButton", { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = UI.btn.fill, Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 4, }, r) corner(btn, 8) stroke(btn, T.stroke, 1, 0.35) local cur = UI.label(btn, "", 14, 0, 96, 34, 12, UI.btn.text, GB) cur.Size = UDim2.new(1, -40, 1, 0) cur.ZIndex = 5 cur.TextTruncate = Enum.TextTruncate.AtEnd chevron(btn) local function paint() cur.Text = tostring(get()) end btn.MouseButton1Click:Connect(function() if dead() then return end if openPopup then W.closePopup() return end local abs, sz = btn.AbsolutePosition, btn.AbsoluteSize local lp = toLocal(Vector2.new(abs.X, abs.Y + sz.Y + 4)) local blocker = new("TextButton", { Name = "PopupBlocker", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 1, }, popupLayer) openPopup = blocker local menu = new("Frame", { Position = UDim2.fromOffset(lp.X, lp.Y), Size = UDim2.fromOffset(sz.X / cardScale.Scale, #options * 28 + 8), BackgroundColor3 = T.panel, BorderSizePixel = 0, ZIndex = 2, }, blocker) corner(menu, 8) stroke(menu, T.stroke, 1, 0.1) for i, opt in ipairs(options) do local o = new("TextButton", { Position = UDim2.fromOffset(4, 4 + (i - 1) * 28), Size = UDim2.new(1, -8, 0, 28), BackgroundColor3 = T.card2, BackgroundTransparency = (get() == opt) and 0 or 1, Text = tostring(opt), TextColor3 = (get() == opt) and T.accent or T.sub, TextSize = 12, Font = GB, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 3, }, menu) corner(o, 6) o.MouseEnter:Connect(function() o.BackgroundTransparency = 0 end) o.MouseLeave:Connect(function() o.BackgroundTransparency = (get() == opt) and 0 or 1 end) o.MouseButton1Click:Connect(function() if dead() then return end set(opt) paint() W.closePopup() if UI.refreshPre